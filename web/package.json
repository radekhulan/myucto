{
  "name": "myucto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run check:i18n-map && npm run check:routes && npm run check:manual && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-map": "node tests/i18n-map.test.mjs",
    "check:routes": "node scripts/check-route-permissions.mjs",
    "check:manual": "node scripts/check-manual-links.mjs",
    "test": "node scripts/run-vitest.mjs run",
    "test:unit": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:pwa": "node --test \"tests/*.test.mjs\"",
    "gen:i18n": "node scripts/gen-i18n-map.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
