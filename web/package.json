{
  "name": "myucto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && npm run check:i18n-map && npm run check:routes && npm run check:manual && npm run type-check:app && vite build",
    "build:image": "npm run check:i18n && npm run check:i18n-map && npm run check:routes && npm run check:manual && vite build",
    "preview": "vite preview",
    "type-check": "node --max-old-space-size=6144 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "type-check:app": "node --max-old-space-size=6144 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-map": "node tests/i18n-map.test.mjs",
    "check:routes": "node scripts/check-route-permissions.mjs",
    "check:manual": "node scripts/check-manual-links.mjs",
    "test": "node scripts/run-vitest.mjs run",
    "test:unit": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:pwa": "node --test --test-concurrency=8 \"tests/*.test.mjs\"",
    "gen:i18n": "node scripts/gen-i18n-map.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
