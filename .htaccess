# MyUcto.cz — Apache configuration
#
# /api/*        → api/public/index.php (Slim FrontController)
# statika       → /styles/, /assets/ a PWA soubory napřímo
# SPA fallback  → api/public/index.php (host gate, potom web/dist/index.html)

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Force HTTPS — vyjma:
    #    - loopback / localhost (lokální dev a Docker port-forward)
    #    - RFC1918 privátní IP (LAN nasazení bez TLS — typicky self-hosted Docker)
    #    - .local mDNS jména
    #    - requests už HTTPS, nebo terminované TLS na reverse proxy (X-Forwarded-Proto)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteCond %{HTTP_HOST} !^10\. [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
    RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
    RewriteCond %{HTTP_HOST} !\.local(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 2) Bezpečnostní bariéra: blokovat citlivé a vývojové složky.
    # `web/shared/` obsahuje zdrojové policy sdílené při buildu, nikoli veřejná data.
    # `(?:\.[^/]*)?` za jménem složky je ZÁMĚRNÉ: na disku reálně existuje
    # `api/vendor.prod/` (produkční autoloader) a holé `vendor(/|$)` ho nematchne
    # (dostane '.', ne '/'). Pokrývá i `private.bak/`, `db.old/` apod. Suffix se
    # kotví na tečku, takže legitimní `/dbxyz` zůstává dostupné.
    RewriteRule ^(private|db|log|source|storage|tools|cmd|docker|web/(src|shared|node_modules)|node_modules|api/(src|vendor|templates|tests|bin))(?:\.[^/]*)?(/|$) - [F,L]

    # 2b) Blokovat cfg.php, tooling manifesty a zdrojové dokumenty.
    # `(?:(?:api|web)/)?` — `api/composer.json` a `api/composer.lock` jsou reálné
    # soubory a root-kotvený regex je minul.
    RewriteRule ^(?:(?:api|web)/)?(cfg\.sample\.php|cfg\.docker\.php|VERSION|web\.config|portainer-template\.json|cfg\.php|cfg\.local\.php|composer\.(json|lock)|package\.json|pnpm-lock\.yaml|(?:vite|tsconfig|eslint|tailwind|postcss)\.config\.[^/]+|phpunit\.xml(?:\.dist)?|Dockerfile(?:\..*)?|docker-compose[^/]*|\.gitignore|\.env.*|[^/]*\.md|[^/]*\.sql)$ - [F,L]

    # 2c) VCS metadata KDEKOLI v cestě. `.git/config` + `.git/HEAD` stačí na
    # rekonstrukci celého repa (zdrojáky, historie, dřív commitnuté secrety).
    # Pravidlo 2b blokuje jen `.gitignore` v rootu, samotný adresář `.git/` ne.
    # IIS to řeší přes hiddenSegments (web.config), Docker přes .dockerignore.
    RewriteRule (^|/)\.(git|svn|hg|bzr)(/|$) - [F,L]

    # 2d) Zámek údržby (H-03) — VRSTVA NAVÍC, ne bezpečnostní hranice.
    #
    # Hlavní kontrola je v PHP (MaintenanceModeMiddleware + inline brána ve
    # front controlleru); ta ale nikdy neuvidí požadavky, které webserver
    # odbaví sám — statiku pod /assets/, /fonts/, /styles/ a PWA soubory.
    # Tohle pravidlo tu díru zavírá tím, že je v údržbě pošle na front
    # controller. Odpověď (503, Retry-After, HTML pro prohlížeč vs. JSON podle
    # `Accept`) proto pořád tvoří PHP na jednom místě — kdyby se tady vracelo
    # `- [R=503]`, přišel by API klient o JSON a o Retry-After.
    #
    # Zámek leží MIMO docroot, takže se na něj míří relativně od něj. Testují se
    # obě rozložení: data dir = rodič docrootu (spravovaná instalace) i data dir
    # = docroot (self-hosted default, kde je `storage/` blokované pravidlem 2).
    # `RewriteRule`/`RewriteCond` spadají do FileInfo, takže se to vejde do
    # `AllowOverride fileinfo indexes limit AuthConfig options=…`.
    #
    # /api/health musí zůstat dostupný i v údržbě — jinak hosting nepozná rozdíl
    # mezi plánovanou údržbou a výpadkem instance.
    # Druhá podmínka je pojistka proti smyčce: per-directory rewrite se v
    # .htaccess vyhodnocuje znovu, takže cíl sám sebe nesmí matchnout.
    RewriteCond %{REQUEST_URI} !^/api/(v1/)?health/?$
    RewriteCond %{REQUEST_URI} !^/api/public/index\.php$
    RewriteCond %{DOCUMENT_ROOT}/../storage/maintenance.lock -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/storage/maintenance.lock -f
    RewriteRule ^ api/public/index.php [L,QSA]

    # Přímá cesta k SPA entry nesmí obejít hostname gate. Hashed assety pod
    # web/dist zůstávají statické, ale index i adresářový default jdou přes PHP.
    RewriteRule ^web/dist(?:/index\.html)?/?$ api/public/index.php [L,QSA]

    # 3a) /assets/* → web/dist/assets/* (Vite generuje absolutní URL `/assets/foo.css`,
    # ale skutečné soubory jsou v `web/dist/assets/`. V IIS to řeší alias z web.config,
    # v Apache musíme přepisovat zde.)
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteRule ^assets/(.*)$ web/dist/assets/$1 [L]

    # 3a-2) /fonts/* → web/dist/fonts/* (self-hostované woff2 z web/public/fonts,
    # které `web/index.html` preloaduje absolutní cestou `/fonts/…`). Bez tohoto
    # pravidla je spolkne SPA fallback (pravidlo 4) a vrátí index.html s Content-Type
    # text/html — prohlížeč font zahodí (`OTS parsing error: invalid sfntVersion`,
    # 0x3C21444F = "<!DO") a celá aplikace spadne na systémový fallback.
    # V IIS to řeší pravidlo „Self-hosted fonts" ve web.config, v nginxu blok 3a-2.
    RewriteCond %{REQUEST_URI} ^/fonts/
    RewriteRule ^fonts/(.*)$ web/dist/fonts/$1 [L]

    # 3b) PWA soubory generované Vitem → web/dist. Service worker musí být
    # dostupný z rootu, aby mohl ovládat celou aplikaci (scope `/`).
    RewriteRule ^service-worker\.js$ web/dist/service-worker.js [E=NOCACHE:1,L]
    RewriteRule ^manifest\.webmanifest$ web/dist/manifest.webmanifest [E=NOCACHE:1,L]
    RewriteRule ^pwa/(.*)$ web/dist/pwa/$1 [L]

    # 3c) /manual a /manual?ch=... → manual/index.php (HTML manuál)
    # Statické soubory v /manual/generated/img/ a /manual/generated/search-index.json
    # se servírují přímo (mají reálné soubory). /manual/img/ (zdroj WEBP) je taky v
    # docroot a serveruje se přímo. Jen "pretty" /manual URL jde přes index.php.
    RewriteRule ^manual/?$ manual/index.php [L,QSA]

    # 3) /api/* → api/public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

    # 4) SPA fallback (vše co není reálný soubor a není /api/* → front controller).
    # Front controller ověří hostname proti supplier_domains a teprve potom vydá
    # web/dist/index.html; neznámý Host tak nedostane ani vstupní HTML aplikace.
    # `!-d` schválně NEPOUŽÍVÁME, jinak by `/` (= docroot dir) tímhle pravidlem neprošlo
    # a Apache by hodil 403 (Options -Indexes + chybějící DirectoryIndex). Statické
    # cesty mají `!-f`, takže je rewrite vynechá.
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/manual
    RewriteCond %{REQUEST_URI} !^/styles/
    RewriteCond %{REQUEST_URI} !^/web/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ api/public/index.php [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self), accelerometer=(self \"https://challenges.cloudflare.com\"), gyroscope=(self \"https://challenges.cloudflare.com\"), magnetometer=(self \"https://challenges.cloudflare.com\"), xr-spatial-tracking=(self \"https://challenges.cloudflare.com\")"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
    # CSP: doplněno unpkg.com (Swagger UI) + cdn.redoc.ly (Redoc) + cdn.jsdelivr.net (Scalar)
    # pro /api/docs, /api/reference a /api/scalar.
    # Sladěno s web.config (IIS). worker-src 'self' blob: je nutné pro Swagger UI tryItOut request snippety.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://validator.swagger.io https://cdn.redoc.ly https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://unpkg.com https://cdn.redoc.ly https://cdn.jsdelivr.net; worker-src 'self' blob:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://unpkg.com https://cdn.redoc.ly https://cdn.jsdelivr.net; frame-src 'self' blob: https://challenges.cloudflare.com chrome-extension: moz-extension:; object-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# Static asset cache
<FilesMatch "\.(woff2|woff|ttf|otf|eot|js|css|svg|png|jpg|jpeg|webp|ico)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>

# SPA entry (index.html) NESMÍ být cachovaná. Hashed assety výše jsou immutable, ale
# index.html drží mapu na jejich aktuální hashe — když ji prohlížeč cachuje, po updatu
# servíruje starou index.html odkazující na staré (z nového buildu smazané) chunky →
# „Failed to fetch dynamically imported module" u lazy-loaded rout (issue #140).
# Zrcadlí outboundRule „HTML no-cache" ve web.config (IIS), kde to už řešené je.
<FilesMatch "\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </IfModule>
</FilesMatch>

# API odpovědi ani PWA řídicí soubory nesmí být cache-ované.
# `<LocationMatch>` není povolený v .htaccess (jen ve server/vhost configu),
# takže používáme rewrite-env trick: nastavíme proměnnou NOCACHE pro /api/*
# a PWA soubory a Header Cache-Control podle ní pošleme.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ - [E=NOCACHE:1]
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "no-store" env=NOCACHE
</IfModule>

# Blokovat citlivé soubory.
# .md zdroje manuálu jsou blokované přímým přístupem — uživatel je dostane jen
# v HTML rendru přes /manual (PHP fopen čte filesystem, ne přes HTTP).
# Pozn.: `yaml|yml` schválně NENÍ v seznamu — `api/openapi.yaml` je veřejný
# OpenAPI spec a musí jít fetchnout (Swagger UI / Redoc). Ostatní .yaml soubory
# jsou v `api/vendor/` a `web/node_modules/`, kde je blokuje rewrite rule výše.
# `.cmd`, `.ps1` a `.sh` sem přibyly s docrootem v kořeni bundlu: pomocné
# skripty leží ve veřejném prostoru a prozrazují cesty i postup nasazení.
<FilesMatch "\.(env|sql|pem|log|lock|md|cmd|ps1|sh)$">
    Require all denied
</FilesMatch>

# VCS metadata — fallback pro případ, že mod_rewrite není načtený (pravidlo 2c
# výše by pak vůbec neplatilo a `.git/HEAD` by se servírovalo jako statika).
# mod_alias je jiný modul, takže obě cesty musí selhat, aby došlo k úniku.
# Vracíme 404 (ne 403), ať se nepotvrzuje existence repa.
<IfModule mod_alias.c>
    RedirectMatch 404 (^|/)\.(git|svn|hg|bzr)(/|$)
</IfModule>

# Skrýt cfg.php přímo
<Files "cfg.php">
    Require all denied
</Files>
<Files "cfg.local.php">
    Require all denied
</Files>

# Manifest je interní vstup PHP a Vite buildu, nikoli veřejný JSON endpoint.
# Tohle pravidlo drží ochranu i v případě, že mod_rewrite není načtený.
<Files "client-route-policy.json">
    Require all denied
</Files>

# MIME
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff  .woff
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
    # OpenAPI spec — Apache by jinak vrátil .yaml jako application/octet-stream
    # (= browser stáhne místo zobrazení). Swagger UI / Redoc fetchne přes /api/openapi.yaml.
    AddType application/yaml .yaml
</IfModule>

# Komprimace
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
