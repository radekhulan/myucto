*.sh  text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# PHP zdroják musí mít stejné konce řádků na Windows i na Linuxu — golden
# heredocy v testech se jinak porovnávají proti CRLF verzi sebe sama.
*.php text eol=lf

# SQL migrace ze stejného důvodu: architekturní testy porovnávají víceřádkové
# úseky DDL proti řetězcům s "\n". S core.autocrlf=true by je Windows checkout
# dostal jako CRLF a testy by padaly na koncích řádků, ne na obsahu.
*.sql text eol=lf

# Vendorovaná XSD schémata se pinují bajt po bajtu přes api/xsd/jmhz/SHA256SUMS.
# Git je nesmí nijak konvertovat, jinak manifest sedí jen na jedné platformě.
*.xsd -text
api/xsd/cssz/**/*.xsd -text -diff
*.xlsx -text
api/resources/payroll/jmhz/**/*.csv -text -diff
api/resources/payroll/jmhz/**/*.ttl -text -diff
api/resources/payroll/jmhz/**/*.pem -text -diff
api/xsd/jmhz/SHA256SUMS text eol=lf
api/resources/payroll/jmhz/SHA256SUMS text eol=lf
api/resources/payroll/jmhz/**/*.json text eol=lf

# Klasifikace CZ-ISCO se pinuje stejným způsobem přes
# api/resources/payroll/cz-isco/SHA256SUMS. Bez těchhle pravidel dostane
# Windows checkout manifest s CRLF, otisk přestane sedět a integritní test
# spadne na koncích řádků místo na obsahu.
api/resources/payroll/cz-isco/SHA256SUMS text eol=lf
api/resources/payroll/cz-isco/**/*.json text eol=lf

# Otevřená data ČSSZ (sazby pojistného) se pinují otiskem staženého souboru —
# ten má CRLF. Bez -text je git při commitu normalizoval na LF, takže otisk
# seděl jen na Windows checkoutu a v Linuxovém CI padal na koncích řádků.
api/resources/payroll/cssz-insurance-rates/**/*.csv -text -diff
api/resources/payroll/cssz-insurance-rates/SHA256SUMS text eol=lf

# CA bundle pro ověření pečeti dodejek EPO je vendorovaný artefakt stažený
# z I.CA a PostSignum. Konce řádků drží tak, jak přišly, a do diffů nepatří —
# je to 500 řádků base64, ne text k revizi.
api/resources/epo/*.pem -text -diff
