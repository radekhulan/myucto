    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="prijmyBezPriznakuType">
    <xs:complexContent>
      <xs:extension base="prijmyType">
        <xs:sequence>
          <xs:element name="odmenyNerezident" type="cislo8Type" minOccurs="0">
