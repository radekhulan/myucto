DS: Průběh zaměstnání v daném měsíci > Neodpracované hodiny (ID 10278)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="hodinyNeodpracDovol" type="cislo8_3Type" minOccurs="0">
