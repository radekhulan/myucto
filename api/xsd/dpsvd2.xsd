                  <xs:attribute name="mesic" use="required">
                    <xs:annotation>
                      <xs:documentation>Vyplňte číslo kalendářního měsíce.&lt;br /&gt;Položka obsahuje kritickou kontrolu: musí být zadáno celé číslo v intervalu 1 až 12.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
