{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#18181b;">Přihlášení účtem organizace</h1>

<p style="margin:0 0 16px;">Dobrý den{% if name %} {{ name }}{% endif %},</p>

<p style="margin:0 0 16px;">do <strong>MyÚčto.cz</strong> se budete přihlašovat účtem Vaší organizace
(<strong>{{ provider }}</strong>). Heslo v MyÚčto nepotřebujete. Při prvním přihlášení použijte
tlačítko níže, Váš účet se tím propojí s účtem organizace:</p>

<p style="margin:24px 0;text-align:center;">
  <a href="{{ inviteLink }}" style="display:inline-block;background:{{ accent }};color:#ffffff;text-decoration:none;font-weight:600;padding:12px 28px;border-radius:6px;font-size:15px;">
    Přihlásit se
  </a>
</p>

<p style="margin:0 0 8px;font-size:13px;color:#71717a;">
  Odkaz je platný <strong>{{ expiresIn|default('3 dny') }}</strong> a lze ho použít jen jednou.
</p>

<p style="margin:0 0 8px;font-size:13px;color:#71717a;">
  Pokud tlačítko nefunguje, zkopírujte tuto adresu do prohlížeče:
</p>

<p style="margin:0;font-size:12px;color:#52525b;word-break:break-all;background:#f4f4f5;padding:10px;border-radius:6px;font-family:monospace;">
  {{ inviteLink }}
</p>

<p style="margin:24px 0 0;font-size:13px;color:#71717a;">
  Potom se už přihlašujete tlačítkem „{{ provider }}“ na přihlašovací stránce.
</p>
{% endblock %}
