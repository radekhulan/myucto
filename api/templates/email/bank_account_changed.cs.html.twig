{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#15131D;">Změna bankovního spojení firmy</h1>
<p style="margin:0 0 16px;">Dobrý den{% if name %} {{ name }}{% endif %},</p>
<p style="margin:0 0 16px;">API token <strong>{{ token_name }}</strong>{% if token_prefix %} ({{ token_prefix }}…){% endif %} právě změnil bankovní spojení měnového účtu <strong>{{ currency_code }}</strong>. Nové údaje se budou tisknout na faktury a do QR platby.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;margin:0 0 16px;font-size:14px;">
  <tr>
    <th style="text-align:left;padding:6px 8px;border-bottom:1px solid #E4E2EA;">Pole</th>
    <th style="text-align:left;padding:6px 8px;border-bottom:1px solid #E4E2EA;">Původně</th>
    <th style="text-align:left;padding:6px 8px;border-bottom:1px solid #E4E2EA;">Nově</th>
  </tr>
  {% for row in changes %}
  <tr>
    <td style="padding:6px 8px;border-bottom:1px solid #F1F0F4;">{{ row.field }}</td>
    <td style="padding:6px 8px;border-bottom:1px solid #F1F0F4;font-family:monospace;">{{ row.before|default('—') }}</td>
    <td style="padding:6px 8px;border-bottom:1px solid #F1F0F4;font-family:monospace;">{{ row.after|default('—') }}</td>
  </tr>
  {% endfor %}
</table>
<p style="margin:0 0 16px;font-size:13px;color:#7A748C;">Čas změny: {{ changed_at }}{% if ip %} · IP adresa: {{ ip }}{% endif %}</p>
<p style="margin:24px 0 0;font-size:13px;color:#7A748C;"><strong>Pokud jste změnu neprováděli</strong>, token ihned zrušte v sekci API tokeny a bankovní účet opravte v Peníze → Bankovní účty.</p>
{% endblock %}
