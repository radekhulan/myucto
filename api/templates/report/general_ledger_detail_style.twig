body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
.title { font-size: 13pt; font-weight: bold; }
.meta { font-size: 8pt; color: #555; }
.account { font-size: 11pt; font-weight: bold; padding-top: 3mm; padding-bottom: 2mm; }
table.account-start { page-break-inside: avoid; margin-top: 4mm; }
table.detail td.account { border-bottom: none; padding-left: 0; font-size: 11pt; font-weight: bold; }
table.detail tr.stripe td { background-color: #f6f6f6; }
table.detail { width: 100%; border-collapse: collapse; margin: 0; table-layout: fixed; }
table.detail td, table.detail th { padding: 1mm; vertical-align: top; font-size: 8pt; }
table.detail th { background-color: #e4e4e4; text-align: left; border-bottom: 0.4pt solid #555; }
table.detail th.money { text-align: right; }
table.detail td { border-bottom: 0.2pt solid #ddd; }
.num { text-align: right; }
.summary { font-weight: bold; background-color: #eeeeee; }
.date { width: 10%; }
.doc { width: 11%; }
.text { width: 37%; }
.counter { width: 9%; }
.money { width: 11%; text-align: right; white-space: nowrap; }
