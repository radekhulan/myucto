<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Opis účtu</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selectory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; padding: 0 6mm; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 2mm; }
    .header-sub { text-align: center; font-size: 8pt; color: #555; margin-top: 1mm; }
    .opening-line { font-size: 9pt; font-weight: bold; margin-bottom: 2mm; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt;
        font-weight: normal;
        color: #555;
        text-align: right;
        padding: 1mm 1.5mm;
        border-bottom: 0.3pt solid #ccc;
        vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td {
        padding: 0.8mm 1.5mm;
        font-size: 8pt;
        border-bottom: 0.2pt solid #eee;
        vertical-align: top;
    }
    table.book tfoot td {
        font-weight: bold;
        font-size: 8pt;
        padding: 1.5mm 1.5mm;
        border-top: 0.5pt solid #333;
        border-bottom: 0.5pt solid #333;
    }
    .num { text-align: right; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %. */
    .col-date { width: 7%; }
    .col-doc { width: 11%; }
    .col-desc { width: 40%; }
    .col-counter { width: 9%; }
    .col-num { width: 11%; }
    .unusual { color: #b91c1c; }
    .sign-note { font-size: 7pt; color: #555; margin-bottom: 2mm; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:30%;">
            <div class="header-meta">Ze dne: {{ "now"|date("d.m.Y") }}</div>
            {% if page and per_page %}
                <div class="header-meta">Strana výběru: {{ page }} (po {{ per_page }})</div>
            {% endif %}
        </td>
        <td style="width:40%;">
            <div class="header-title">Opis účtu {{ account.code }}</div>
            <div class="header-period">{{ account.name }}</div>
            {% if from or to %}
                <div class="header-sub">Za období: {{ from|cz_date }} – {{ to|cz_date }}</div>
            {% endif %}
        </td>
        <td style="width:30%;"></td>
    </tr>
</table>

<div class="opening-line">Počáteční zůstatek: <span class="{{ opening_balance_unusual ? 'unusual' : '' }}">{{ (opening_balance_signed ?? opening_balance)|cz_money }}</span></div>
{% if opening_balance_signed is defined %}
    <div class="sign-note">Zůstatek je se znaménkem podle typu účtu, červeně neobvyklá strana.</div>
{% endif %}
{% if counter_filter %}
    <div class="sign-note">Filtr protiúčtu: {{ counter_filter.account_code }} {{ counter_filter.name }}. Zůstatek je zůstatek celého účtu.</div>
{% endif %}

{% if items is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">
        Na účtu nejsou ve zvoleném období žádné pohyby.
    </p>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-date">Datum</th>
            <th class="thl col-doc">Doklad</th>
            <th class="thl col-desc">Popis</th>
            <th class="thl col-counter">Protiúčet</th>
            <th class="col-num">MD</th>
            <th class="col-num">D</th>
            <th class="col-num">Zůstatek</th>
        </tr>
    </thead>
    <tbody>
        {% for item in items %}
            <tr>
                <td class="col-date">{{ item.entry_date|cz_date }}</td>
                <td class="col-doc">{{ item.document_no }}</td>
                <td class="col-desc">{{ item.description|slice(0, 60) }}</td>
                <td class="col-counter">{{ item.counter_accounts }}{% if item.pair_status is defined and item.pair_status == 'composite_mn' %} (M : N){% endif %}</td>
                <td class="num col-num">{{ item.side == 'debit' ? item.amount|cz_money : '' }}</td>
                <td class="num col-num">{{ item.side == 'credit' ? item.amount|cz_money : '' }}</td>
                <td class="num col-num {{ item.balance_unusual ? 'unusual' : '' }}">{{ (item.balance_signed ?? item.balance)|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="4">Obraty za období / konečný zůstatek</td>
            <td class="num">{{ turnover_md|cz_money }}</td>
            <td class="num">{{ turnover_d|cz_money }}</td>
            <td class="num {{ closing_balance_unusual ? 'unusual' : '' }}">{{ (closing_balance_signed ?? closing_balance)|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

{% if counter_totals is not empty %}
<div class="opening-line" style="margin-top:4mm;">Součty podle protiúčtu</div>
<table class="book">
    <thead>
        <tr>
            <th class="thl col-doc">Protiúčet</th>
            <th class="thl" style="width:67%;">Název</th>
            <th class="col-num">MD</th>
            <th class="col-num">D</th>
        </tr>
    </thead>
    <tbody>
        {% for row in counter_totals %}
            <tr>
                <td class="col-doc">{{ row.account_code ?? 'bez protiúčtu' }}</td>
                <td>{{ row.name }}</td>
                <td class="num col-num">{{ row.md|cz_money }}</td>
                <td class="num col-num">{{ row.d|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

</body>
</html>
