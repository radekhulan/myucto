<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Inventarizace rozvahových účtů</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selectory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; padding: 0 6mm; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 2mm; }
    .header-sub { text-align: center; font-size: 8pt; color: #555; margin-top: 1mm; }
    .legal-note { font-size: 7pt; color: #555; margin-bottom: 3mm; }
    .draft-warning {
        background-color: #fef3c7;
        color: #92400e;
        font-size: 8pt;
        padding: 1.5mm 2mm;
        margin-bottom: 3mm;
    }
    .fillin-line { display: inline-block; border-bottom: 0.3pt solid #999; width: 45mm; }
    table.book { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    table.book thead th {
        font-size: 7pt;
        font-weight: normal;
        color: #555;
        text-align: right;
        padding: 1mm 1.5mm;
        border-bottom: 0.3pt solid #ccc;
        vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td {
        padding: 0.8mm 1.5mm;
        font-size: 8pt;
        border-bottom: 0.2pt solid #eee;
        vertical-align: top;
    }
    table.book tfoot td {
        font-weight: bold;
        font-size: 8pt;
        padding: 1.5mm 1.5mm;
        border-top: 0.5pt solid #333;
        border-bottom: 0.5pt solid #333;
    }
    .num { text-align: right; }
    .col-account { width: 16mm; }
    .col-name { width: 46mm; }
    .col-side { width: 9mm; text-align: center; }
    .col-blank { width: 22mm; background-color: #fafafa; }
    .col-resolved { width: 10mm; text-align: center; }
    .col-note { width: 34mm; }
    .col-hint { width: 40mm; }
    .row-synthetic { font-weight: bold; background-color: #f4f4f5; }
    .indent { padding-left: 4mm; }
    .protocol-note { font-size: 8pt; margin-bottom: 3mm; }
    .sign-table { width: 100%; border-collapse: collapse; margin-top: 12mm; }
    .sign-cell { width: 50%; font-size: 8pt; color: #555; padding-top: 8mm; border-top: 0.3pt solid #999; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:28%;">
            <div class="header-meta">{{ entity.name }}</div>
            <div class="header-meta">IČO: {{ entity.ico }}</div>
            <div class="header-meta">{{ entity.address }}</div>
        </td>
        <td style="width:44%;">
            <div class="header-title">{{ report_title|default('Inventarizace rozvahových účtů') }}</div>
            <div class="header-period">k rozvahovému dni {{ as_of|cz_date }}</div>
            <div class="header-sub">Fiskální rok {{ period.fiscal_year }} · Sestaveno: {{ entity.prepared_at }}</div>
        </td>
        <td style="width:28%;">
            <div class="header-meta">Datum provedení inventarizace: {{ inventory.inventory_date ? inventory.inventory_date|cz_date : '' }}</div>
            <div class="header-meta">Odpovědná osoba: {{ inventory.responsible_person }}</div>
            <div class="header-meta">Protokol: {{ inventory.protocol_ref }}</div>
            {% if inventory %}<div class="header-meta">Stav: {{ inventory.completed ? 'dokončeno' : 'rozpracováno' }}</div>{% endif %}
        </td>
    </tr>
</table>

<div class="legal-note">
    {{ legal_note|default('Inventarizace majetku a závazků dle §29–30 zákona č. 563/1991 Sb., o účetnictví: soupis rozvahových účtů (třídy 0–4) s konečným zůstatkem k rozvahovému dni, odsouhlasením na skutečný stav a způsobem doložení. Prázdné sloupce „Skutečný stav" a „Rozdíl" se doplňují ručně na základě provedené fyzické/dokladové inventury.') }}
    {% if inventory %}Účetní zůstatky jsou v KZ MD a KZ D. Skutečný stav a rozdíl jsou na normální straně účtu; účet se stranou ± znaménkově (kladně MD, záporně Dal).{% endif %}
</div>

{% if inventory.note %}
    <div class="protocol-note">Poznámka: {{ inventory.note }}</div>
{% endif %}
{% if inventory.back_filled %}
    <div class="draft-warning">Skutečný stav je doplněn z účetních zůstatků uzavřeného období, nejde o doklad o provedené inventuře.</div>
{% endif %}

{% if draft_count > 0 %}
    <div class="draft-warning">V období je {{ draft_count }} nezaúčtovaných konceptů — nejsou zahrnuty do zůstatků.</div>
{% endif %}

{% if rows is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">
        K rozvahovému dni nejsou žádné rozvahové účty se zůstatkem ani pohybem.
    </p>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-account">Účet</th>
            <th class="thl col-name">Název</th>
            <th class="col-side">Strana</th>
            <th>KZ MD</th>
            <th>KZ D</th>
            <th class="col-blank">Skutečný stav</th>
            <th class="col-blank">Rozdíl</th>
            <th class="col-resolved">Vyřešeno</th>
            <th class="thl col-note">Poznámka</th>
            <th class="thl col-hint">Způsob doložení</th>
        </tr>
    </thead>
    <tbody>
        {% for row in protocol_rows ?? rows %}
            <tr class="{{ row.kind == 'synthetic' ? 'row-synthetic' : '' }}">
                <td class="{{ row.kind == 'analytic' ? 'indent' : '' }}">{{ row.account_code }}</td>
                <td>{{ row.name|slice(0, 46) }}</td>
                <td class="col-side">{% if row.normal_side is defined %}{{ row.normal_side == 'debit' ? 'MD' : (row.normal_side == 'credit' ? 'Dal' : '±') }}{% endif %}</td>
                <td class="num">{{ row.ks_md|cz_money }}</td>
                <td class="num">{{ row.ks_d|cz_money }}</td>
                <td class="col-blank num">{{ row.counted_display is not null ? row.counted_display|cz_money : '' }}&nbsp;</td>
                <td class="col-blank num">{{ row.difference_display is not null ? row.difference_display|cz_money : '' }}&nbsp;</td>
                <td class="col-resolved">{% if row.resolved is defined %}{{ row.resolved ? 'ano' : 'ne' }}{% endif %}</td>
                <td>{{ row.item_note }}</td>
                <td>{{ row.documentation_hint }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3">CELKEM ({{ count }} účtů)</td>
            <td class="num">{{ totals.ks_md|cz_money }}</td>
            <td class="num">{{ totals.ks_d|cz_money }}</td>
            <td class="col-blank"></td>
            <td class="col-blank"></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    </tfoot>
</table>

<table class="sign-table">
    <tr>
        <td class="sign-cell">Inventarizaci provedl (datum, podpis)</td>
        <td class="sign-cell">Schválil, odpovědná osoba{{ inventory.responsible_person ? ' ' ~ inventory.responsible_person : '' }} (datum, podpis)</td>
    </tr>
</table>
{% endif %}

</body>
</html>
