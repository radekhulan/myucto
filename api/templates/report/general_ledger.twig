<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Hlavní kniha</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selectory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; padding: 0 6mm; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 2mm; }
    .header-sub { text-align: center; font-size: 8pt; color: #555; margin-top: 1mm; }
    .draft-warning {
        background-color: #fef3c7;
        color: #92400e;
        font-size: 8pt;
        padding: 1.5mm 2mm;
        margin-bottom: 3mm;
    }
    table.book { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    table.book thead th {
        font-size: 7pt;
        font-weight: normal;
        color: #555;
        text-align: right;
        padding: 1mm 1mm;
        border-bottom: 0.3pt solid #ccc;
        vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td {
        padding: 0.8mm 1mm;
        font-size: 7.5pt;
        border-bottom: 0.2pt solid #eee;
        vertical-align: top;
    }
    table.book tfoot td {
        font-weight: bold;
        font-size: 8pt;
        padding: 1.5mm 1mm;
        border-top: 0.5pt solid #333;
        border-bottom: 0.5pt solid #333;
    }
    .num { text-align: right; }
    .col-account { width: 14mm; }
    .col-name { width: 46mm; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:30%;">
            <div class="header-meta">Ze dne: {{ "now"|date("d.m.Y") }}</div>
        </td>
        <td style="width:40%;">
            <div class="header-title">Hlavní kniha</div>
            <div class="header-period">{% if all_periods %}Všechna účetní období{% else %}Fiskální rok {{ period.fiscal_year }}{% endif %}</div>
            <div class="header-sub">Za období: {{ from|cz_date }} – {{ to|cz_date }}{% if analytics %} · rozpad po analytikách{% endif %}</div>
        </td>
        <td style="width:30%;"></td>
    </tr>
</table>

{% if draft_count > 0 %}
    <div class="draft-warning">V rozsahu je {{ draft_count }} nezaúčtovaných konceptů — nejsou zahrnuty do obratů.</div>
{% endif %}

{% if accounts is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">
        Pro zvolené období nejsou v hlavní knize žádné pohyby ani počáteční stavy.
    </p>
{% else %}
{% set monthly = months|length <= 6 %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-account">Účet</th>
            <th class="thl col-name">Název</th>
            <th>PS MD</th>
            <th>PS D</th>
            {% if monthly %}
                {% for m in months %}
                    <th>{{ m|slice(5, 2) }}/{{ m|slice(0, 4) }} MD</th>
                    <th>{{ m|slice(5, 2) }}/{{ m|slice(0, 4) }} D</th>
                {% endfor %}
            {% endif %}
            <th>Obrat MD</th>
            <th>Obrat D</th>
            <th>KS MD</th>
            <th>KS D</th>
        </tr>
    </thead>
    <tbody>
        {% for acc in accounts %}
            <tr>
                <td>{{ acc.account_code }}</td>
                <td>{{ acc.name|slice(0, 42) }}</td>
                <td class="num">{{ acc.opening_md|cz_money }}</td>
                <td class="num">{{ acc.opening_d|cz_money }}</td>
                {% if monthly %}
                    {% for m in months %}
                        <td class="num">{{ (acc.months[m].md ?? 0)|cz_money }}</td>
                        <td class="num">{{ (acc.months[m].d ?? 0)|cz_money }}</td>
                    {% endfor %}
                {% endif %}
                <td class="num">{{ acc.turnover_md|cz_money }}</td>
                <td class="num">{{ acc.turnover_d|cz_money }}</td>
                <td class="num">{{ acc.closing_md|cz_money }}</td>
                <td class="num">{{ acc.closing_d|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="2">SOUČTY</td>
            <td class="num">{{ totals.opening_md|cz_money }}</td>
            <td class="num">{{ totals.opening_d|cz_money }}</td>
            {% if monthly and months is not empty %}
                <td colspan="{{ months|length * 2 }}"></td>
            {% endif %}
            <td class="num">{{ totals.turnover_md|cz_money }}</td>
            <td class="num">{{ totals.turnover_d|cz_money }}</td>
            <td class="num">{{ totals.closing_md|cz_money }}</td>
            <td class="num">{{ totals.closing_d|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

</body>
</html>
