<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Stav zásob</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; margin-bottom: 2mm; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt; font-weight: normal; color: #555; text-align: right;
        padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.8mm 1.5mm; font-size: 8pt; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    table.book tfoot td { font-weight: bold; font-size: 8pt; padding: 1.5mm 1.5mm; border-top: 0.5pt solid #333; }
    .num { text-align: right; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %.
       Šířky podle zvolených sloupců počítá StockStatusColumns (výchozí = původních osm). */
{% for col in layout %}
    .col-{{ col.key }} { width: {{ col.width }}%; }
{% endfor %}
    .below-min { color: #b91c1c; font-weight: bold; }
</style>
</head>
<body>

<div class="header-title">Stav zásob k {{ "now"|date("d.m.Y") }}</div>

{% if items is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">Žádné skladové zásoby neodpovídají zvoleným filtrům.</p>
{% else %}
{% set value_index = null %}
{% for col in layout %}{% if col.key == 'value_total' %}{% set value_index = loop.index0 %}{% endif %}{% endfor %}
<table class="book">
    <thead>
        <tr>
            {% for col in layout %}
            <th class="{{ col.numeric ? '' : 'thl ' }}col-{{ col.key }}">{{ col.label }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for row in items %}
            <tr>
                {% for col in layout %}
                {% if col.key == 'name' %}
                <td class="col-name">{{ row.name|slice(0, name_chars) }}</td>
                {% elseif col.key == 'qty' %}
                <td class="num col-qty {{ row.min_qty and row.qty < row.min_qty ? 'below-min' : '' }}">{{ row.qty|cz_money }}</td>
                {% elseif col.key == 'sale_price' %}
                {# Cena karty přichází ve tvaru „12.50“ / „0.0108“: haléřová na dvě místa, levnější na svá. #}
                <td class="num col-sale_price">{{ row.sale_price is null ? '' : row.sale_price|number_format(row.sale_price|split('.')|last|length, ',', ' ') }}</td>
                {% elseif col.key == 'note' %}
                <td class="col-note">{{ row.note is null ? '' : row.note|slice(0, 120) }}</td>
                {% elseif col.numeric %}
                <td class="num col-{{ col.key }}">{{ row[col.key] is null ? '' : row[col.key]|cz_money }}</td>
                {% else %}
                <td class="col-{{ col.key }}">{{ row[col.key] }}</td>
                {% endif %}
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            {% if value_index is null %}
            <td colspan="{{ layout|length }}">CELKEM ({{ totals.count }} položek)</td>
            {% else %}
            <td colspan="{{ value_index }}">CELKEM ({{ totals.count }} položek)</td>
            <td class="num">{{ totals.value_total|cz_money }}</td>
            {% if value_index + 1 < layout|length %}<td colspan="{{ layout|length - value_index - 1 }}"></td>{% endif %}
            {% endif %}
        </tr>
    </tfoot>
</table>
{% endif %}

</body>
</html>
