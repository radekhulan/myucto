body { font-size: 10pt; color: #221e33; }
h1 { margin: 2mm 0; font-size: 22pt; }
h2 { font-size: 12pt; margin: 0 0 2mm; }
.head { border-bottom: 1pt solid #3b2d83; padding-bottom: 5mm; margin-bottom: 5mm; }
.doc-type { color: #3b2d83; font-size: 12pt; font-weight: bold; }
.logo { text-align: right; vertical-align: middle; }
.parties { margin-bottom: 5mm; background: #f6f5fa; }
.party-customer { background: #f1eef8; }
.parties h2 { color: #3b2d83; }
.section-title { margin-top: 6mm; page-break-after: avoid; }
.tag { font-size: 8pt; color: #3b2d83; }
.markdown { line-height: 1.4; }
.markdown h1, .markdown h2, .markdown h3 { font-size: 11pt; }
.markdown th, .markdown td { border: 0.5pt solid #dedbe7; padding: 1.5mm; }
.markdown blockquote { border-left: 1pt solid #dedbe7; padding-left: 3mm; }
.items { font-size: 9pt; border-collapse: collapse; margin: 2mm 0 1mm; }
.items th { background: #3b2d83; color: #fff; }
.items th, .items td, .totals-table td, .totals-table th { text-align: right; }
.items td { border-bottom: 0.5pt solid #dedbe7; }
.items .left, .totals-table th:first-child { text-align: left; }
.totals-table { font-size: 9pt; margin: 2mm 0; border-collapse: collapse; page-break-inside: avoid; }
.totals-table th { background: #f1eef8; color: #3b2d83; }
.totals-table .grand td { font-weight: bold; border-bottom: 0.5pt solid #dedbe7; }
.unit-note { font-size: 8pt; color: #615b73; }
