<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Výplatní páska</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 7.8pt; color: #211923; }
    .accent { height: 1.6mm; background: #98466F; margin-bottom: 3mm; }
    .header { width: 100%; border-collapse: collapse; margin-bottom: 2.5mm; }
    .header td { padding: 0; vertical-align: bottom; }
    .title { font-size: 15pt; font-weight: bold; color: #351C2B; }
    .employer { color: #5F515A; font-size: 8pt; margin-top: 0.6mm; }
    .period-label { color: #7D6E78; font-size: 6.8pt; text-transform: uppercase; text-align: right; }
    .period { font-size: 14pt; font-weight: bold; color: #98466F; text-align: right; }
    .section { margin: 2.6mm 0 0.9mm 0; color: #98466F; font-size: 7.6pt; font-weight: bold; text-transform: uppercase; }
    table.grid { width: 100%; border-collapse: collapse; border: 0.35pt solid #DEC8D4; }
    table.grid td { padding: 0.9mm 1.4mm; border-bottom: 0.2pt solid #EEE3E9; vertical-align: top; }
    table.grid td.k { color: #5F515A; width: 19%; }
    table.grid td.v { text-align: right; font-family: geistmono, dejavusans, sans-serif; white-space: nowrap; width: 14.3%; border-right: 0.35pt solid #DEC8D4; }
    table.grid td.v.last { border-right: 0; }
    table.grid td.v.txt { font-family: montserrat, dejavusans, sans-serif; white-space: normal; }
    table.grid td.strong, table.grid td.v.strong { font-weight: bold; color: #351C2B; }
    table.lines { width: 100%; border-collapse: collapse; border: 0.35pt solid #DEC8D4; }
    table.lines td { padding: 0.8mm 1.4mm; border-bottom: 0.2pt solid #EEE3E9; }
    table.lines td.v { text-align: right; font-family: geistmono, dejavusans, sans-serif; white-space: nowrap; width: 32mm; }
    table.lines tr.total td { font-weight: bold; border-top: 0.5pt solid #98466F; color: #351C2B; }
    table.lines tr.muted td { color: #7D6E78; }
    .statute { color: #7D6E78; font-size: 6.6pt; }
    .net-box { margin-top: 2.8mm; background: #FAF1F6; border: 0.7pt solid #98466F; padding: 2.2mm 3mm; }
    .net-table { width: 100%; border-collapse: collapse; }
    .net-table td { padding: 0; vertical-align: middle; }
    .net-label { color: #6B3951; font-size: 8.4pt; font-weight: bold; text-transform: uppercase; }
    .net-account { color: #5F515A; font-size: 7.2pt; margin-top: 0.5mm; }
    .net-value { text-align: right; color: #6B2949; font-family: geistmono, dejavusans, sans-serif; font-size: 15pt; font-weight: bold; white-space: nowrap; }
</style>
</head>
<body>
{% macro pair(label, value, last = false, strong = false) %}
    <td class="k{{ strong ? ' strong' : '' }}">{{ label }}</td>
    <td class="v{{ last ? ' last' : '' }}{{ strong ? ' strong' : '' }}">{{ value }}</td>
{% endmacro %}
{% macro empty(last = false) %}
    <td class="k"></td><td class="v{{ last ? ' last' : '' }}"></td>
{% endmacro %}
{% import _self as ui %}
{% set s = supplement %}
{% set money = currency %}

<div class="accent"></div>

<table class="header">
    <tr>
        <td style="width:70%;">
            <div class="title">Výplatní páska</div>
            <div class="employer">{{ employer.name }} · IČO {{ employer.identification_number }}</div>
        </td>
        <td style="width:30%;">
            <div class="period-label">Mzdové období</div>
            <div class="period">{{ period }}</div>
        </td>
    </tr>
</table>

<table class="grid">
    <tr>
        <td class="k">Zaměstnanec</td><td class="v txt strong">{{ employee.display_name }}</td>
        <td class="k">Osobní číslo</td><td class="v txt">{{ s and s.personal_number ? s.personal_number : '—' }}</td>
        <td class="k">Vztah</td><td class="v txt last">{{ employment_label }}</td>
    </tr>
</table>

{% if s %}
{% set t = s.time %}
<div class="section">Docházka a dovolená</div>
<table class="grid">
    {% if s.has_time %}
    <tr>
        {{ ui.pair('Kalendářní dny', t.calendar_days is null ? '—' : t.calendar_days ~ ' d') }}
        {{ ui.pair('Fond pracovní doby', t.fund_millihours|hours ~ ' h') }}
        {{ ui.pair('Odpracováno', (t.worked_days is null ? '—' : t.worked_days ~ ' d') ~ ' / ' ~ t.worked_millihours|hours ~ ' h', true) }}
    </tr>
    <tr>
        {{ ui.pair('Svátky', t.holiday_millihours|hours ~ ' h') }}
        {{ ui.pair('Dovolená', t.vacation_millihours|hours ~ ' h') }}
        {{ ui.pair('Náhrada za dovolenou', s.groups.vacation_pay|minor_money, true) }}
    </tr>
    <tr>
        {{ ui.pair('Zbývající dovolená', s.remaining_vacation_minutes is null ? '—' : s.remaining_vacation_minutes|minutes_hours ~ ' h') }}
        {{ ui.pair('Placené volno a překážky', t.paid_obstacle_millihours|hours ~ ' h') }}
        {{ ui.pair('Nemoc / OČR', t.sickness_millihours|hours ~ ' / ' ~ t.care_millihours|hours ~ ' h', true) }}
    </tr>
    <tr>
        {{ ui.pair('Neplacené volno', t.unpaid_leave_millihours|hours ~ ' h') }}
        {{ ui.pair('Přesčasy', t.overtime_millihours|hours ~ ' h') }}
        {{ ui.pair('Použitý průměr', s.average_hourly_minor_units is null ? '—' : s.average_hourly_minor_units|minor_money ~ ' Kč/h', true) }}
    </tr>
    {% else %}
    <tr>
        {{ ui.pair('Náhrada za dovolenou', s.groups.vacation_pay|minor_money) }}
        {{ ui.pair('Zbývající dovolená', s.remaining_vacation_minutes is null ? '—' : s.remaining_vacation_minutes|minutes_hours ~ ' h') }}
        {{ ui.pair('Použitý průměr', s.average_hourly_minor_units is null ? '—' : s.average_hourly_minor_units|minor_money ~ ' Kč/h', true) }}
    </tr>
    {% endif %}
</table>

<div class="section">Mzda podle druhu</div>
<table class="grid">
    <tr>
        {{ ui.pair('Základní mzda', s.groups.base_wage|minor_money) }}
        {{ ui.pair('Prémie a odměny', s.groups.bonuses|minor_money) }}
        {{ ui.pair('Přesčasy', s.groups.overtime_pay|minor_money, true) }}
    </tr>
    <tr>
        {{ ui.pair('Náhrady mzdy', s.groups.compensations|minor_money) }}
        {{ ui.pair('Stravenkový paušál', s.groups.meal_allowance|minor_money) }}
        {{ ui.pair('Nezdanitelné náhrady', s.groups.reimbursements|minor_money, true) }}
    </tr>
</table>
{% endif %}

<div class="section">Složky mzdy</div>
{% if hourly_claims is defined and income_lines|filter(line => line.hourly_detail is defined and line.hourly_detail.display_basis == 'delta')|length > 0 %}
<p class="statute">Celkový přepočet obsahuje také dříve zúčtované složky. Nové změny jsou označeny jako zúčtovaný rozdíl; souhrn přepočtené mzdy není částkou nového doplatku.</p>
{% endif %}
<table class="lines">
    {% for line in income_lines %}
    <tr>
        <td>{{ line.label }}{% if line.exemption_statute %} <span class="statute">nezdaňuje se podle {{ line.exemption_statute }}{% if line.exempt_part_minor_units != line.amount_minor_units %} v částce {{ line.exempt_part_minor_units|minor_money }} {{ money }}{% endif %}</span>{% endif %}{% if line.hourly_detail is defined %}<br><span class="statute">{% if line.hourly_detail.display_basis == 'delta' %}Zúčtovaný rozdíl{% else %}Doložené množství{% endif %}{% if line.hourly_detail.quantity_text is not null %}: {{ line.hourly_detail.quantity_text }}{% endif %}{% if line.hourly_detail.rate_minor is not null %} × {{ line.hourly_detail.rate_minor|minor_money }} Kč/h{% endif %}</span>{% endif %}</td>
        <td class="v">{{ line.amount_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% endfor %}
    <tr class="total">
        <td>Hrubá mzda</td>
        <td class="v">{{ gross_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% if income_detail_status == 'recorded' and tax_exempt_income_minor_units != 0 %}
    <tr class="muted"><td>z toho osvobozeno od daně</td><td class="v">{{ tax_exempt_income_minor_units|minor_money }} {{ money }}</td></tr>
    {% endif %}
    {% if income_detail_status == 'recorded' and not_subject_to_tax_income_minor_units != 0 %}
    <tr class="muted"><td>z toho není předmětem daně</td><td class="v">{{ not_subject_to_tax_income_minor_units|minor_money }} {{ money }}</td></tr>
    {% endif %}
</table>

<div class="section">Pojistné</div>
<table class="grid">
    <tr>
        {{ ui.pair('Sociální zaměstnanec', employee_social_minor_units|minor_money) }}
        {{ ui.pair('Zdravotní zaměstnanec', employee_health_minor_units|minor_money) }}
        {{ ui.pair('Doplatek ZP do minima', health_minimum_top_up_minor_units|minor_money, true) }}
    </tr>
    <tr>
        {{ ui.pair('Sociální zaměstnavatel', employer_social_minor_units|minor_money) }}
        {{ ui.pair('Zdravotní zaměstnavatel', employer_health_minor_units|minor_money) }}
        {{ ui.pair('Osobní náklady', total_employer_cost_minor_units|minor_money, true, true) }}
    </tr>
</table>

<div class="section">Daň z příjmů</div>
{% set credit_lines = s ? s.credit_lines : [] %}
<table class="grid">
    <tr>
        {{ ui.pair('Zdanitelný příjem', (s and s.taxable_income_minor_units is not null ? s.taxable_income_minor_units : tax_base_minor_units)|minor_money) }}
        {{ ui.pair('Základ daně', tax_base_minor_units|minor_money) }}
        {{ ui.pair('Daň před slevami', tax_before_credits_minor_units|minor_money, true) }}
    </tr>
    <tr>
        {% if credit_lines is empty %}
        {{ ui.pair('Slevy na dani', tax_non_refundable_credits_minor_units|minor_money) }}
        {{ ui.empty() }}
        {% else %}
        {% for line in credit_lines|slice(0, 2) %}
        {{ ui.pair(line.label, line.amount_minor_units|minor_money) }}
        {% endfor %}
        {% if credit_lines|length < 2 %}{{ ui.empty() }}{% endif %}
        {% endif %}
        {{ ui.pair('Zvýhodnění na děti', tax_child_credit_minor_units|minor_money, true) }}
    </tr>
    {% if credit_lines|length > 2 %}
    <tr>
        {% for line in credit_lines|slice(2, 2) %}
        {{ ui.pair(line.label, line.amount_minor_units|minor_money) }}
        {% endfor %}
        {% if credit_lines|length < 4 %}{{ ui.empty() }}{% endif %}
        {{ ui.empty(true) }}
    </tr>
    {% endif %}
    <tr>
        {{ ui.pair('Záloha na daň', tax_after_credits_minor_units|minor_money, false, true) }}
        {{ ui.pair('Daňový bonus', tax_bonus_minor_units|minor_money) }}
        {{ ui.pair('Čistá mzda', net_wage_minor_units|minor_money, true, true) }}
    </tr>
</table>

<div class="section">Výplata</div>
<table class="lines">
    <tr>
        <td>Čistá mzda</td>
        <td class="v">{{ net_wage_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% for line in other_deduction_lines %}
    <tr>
        <td>Srážka: {{ line.label }}</td>
        <td class="v">-{{ line.amount_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% endfor %}
    {% if rounding_adjustment_minor_units != 0 %}
    <tr class="muted">
        <td>Zaokrouhlení</td>
        <td class="v">{{ rounding_adjustment_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% endif %}
    {% if annual_settlement_minor_units != 0 %}
    <tr>
        <td>Doplatek z ročního zúčtování záloh</td>
        <td class="v">{{ annual_settlement_minor_units|minor_money }} {{ money }}</td>
    </tr>
    {% endif %}
</table>

<div class="net-box">
    <table class="net-table">
        <tr>
            <td>
                <div class="net-label">{{ net_minor_units < 0 ? 'Přeplatek zaměstnance' : 'K výplatě' }}</div>
                {% if s and s.payout_account %}<div class="net-account">na účet {{ s.payout_account }}</div>{% endif %}
            </td>
            <td class="net-value">{{ net_minor_units|minor_money }} {{ money }}</td>
        </tr>
    </table>
</div>

{% if hourly_claims is defined and hourly_claims %}
<pagebreak />
<div class="title">Rozpis hodinových nároků</div>
<div class="employer">{{ employee.display_name }} · {{ period }}</div>
<p>Úplné nároky za pracovní období. V části Složky mzdy jsou skutečně zúčtované částky, při opravě pouze jejich rozdíl. Částky úseků jsou analytické; nárok se zaokrouhluje jednou za měsíc a druh nároku.</p>
{% for claim in hourly_claims %}
{% if claim.payable_minor != 0 or claim.previous_payable_minor != 0 or claim.full_duration_units != 0 %}
<div class="section">{{ claim.label }} · {{ claim.work_period_start }}</div>
<table class="lines">
{% for part in claim.segments %}
<tr><td>{{ part.date_from }} – {{ part.date_to }}<br>{{ part.quantity_text }}{% if part.rate_minor is not null %} × {{ part.rate_minor|minor_money }} Kč/h{% elseif part.monthly_gross_minor is not null %} · měsíční sazba {{ part.monthly_gross_minor|minor_money }} Kč{% endif %}{% if part.rate_label is not null %}<br><span class="statute">{{ part.rate_label }}</span>{% endif %}</td><td class="v">{{ part.analytical_minor|minor_money }} Kč{% if claim.segment_role == 'minimum_threshold' %}<br><span class="statute">zákonné minimum</span>{% endif %}</td></tr>
{% endfor %}
{% if claim.segment_display_adjustment_minor is not null and claim.segment_display_adjustment_minor != 0 %}<tr class="muted"><td>Rozdíl zobrazení úseků na haléře</td><td class="v">{{ claim.segment_display_adjustment_minor|minor_money }} Kč</td></tr>{% endif %}
{% if claim.minimum_assessment is not null and claim.minimum_assessment.threshold is defined and claim.minimum_assessment.eligible is defined %}
<tr><td>Zákonná hranice minimální mzdy</td><td class="v">{{ claim.minimum_assessment.threshold.analytical_minor|minor_money }} Kč</td></tr>
<tr><td>Započitatelná dosažená mzda</td><td class="v">{{ claim.minimum_assessment.eligible.analytical_minor|minor_money }} Kč</td></tr>
{% endif %}
<tr><td>Přesný nárok zobrazený na haléře</td><td class="v">{{ claim.analytical_minor|minor_money }} Kč</td></tr>
<tr><td>Korunové zaokrouhlení nároku</td><td class="v">{{ claim.rounding_adjustment_minor|minor_money }} Kč</td></tr>
<tr class="total"><td>Úplný splatný nárok</td><td class="v">{{ claim.payable_minor|minor_money }} Kč</td></tr>
<tr><td>Dříve zúčtováno</td><td class="v">{{ claim.previous_payable_minor|minor_money }} Kč</td></tr>
<tr class="total"><td>Rozdíl této revize</td><td class="v">{{ claim.delta_amount_minor|minor_money }} Kč</td></tr>
</table>
{% endif %}
{% endfor %}
{% endif %}
</body>
</html>
