<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Stejnopis evidenčního listu důchodového pojištění</title>
<style>
body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #211923; line-height: 1.3; }
.accent { height: 2mm; background: #98466F; margin-bottom: 3mm; }
.title { font-size: 15pt; font-weight: bold; color: #351C2B; }
.subtitle { color: #6B5C66; margin-top: 1mm; }
.section { margin: 3mm 0 1mm; color: #98466F; font-size: 7.8pt; font-weight: bold; text-transform: uppercase; }
.grid { width: 100%; border-collapse: collapse; }
.grid td, .grid th { border: 0.3pt solid #DEC8D4; padding: 1.5mm; vertical-align: top; }
.grid th { background: #FAF1F6; color: #5F515A; text-align: left; font-size: 6.6pt; }
.num { text-align: right; }
.label { color: #7D6E78; font-size: 6.3pt; text-transform: uppercase; }
.value { margin-top: 0.5mm; font-weight: bold; }
.note { margin-top: 2mm; border: 0.3pt solid #DEC8D4; background: #F8F5F7; padding: 1.7mm; }
.signature { margin-top: 5mm; width: 100%; border-collapse: collapse; }
.signature td { width: 50%; vertical-align: bottom; padding-right: 5mm; }
.line { border-top: 0.3pt solid #7D6E78; padding-top: 1mm; margin-top: 8mm; }
.mono { font-family: geistmono, dejavusans, sans-serif; font-size: 5.8pt; color: #7D6E78; }
</style>
</head>
<body>
<div class="accent"></div>
<div class="title">Stejnopis evidenčního listu důchodového pojištění za rok {{ year }}</div>
<div class="subtitle">{{ variant == 'employer' ? 'Pro evidenci zaměstnavatele · § 35a odst. 4 písm. a) a' : 'Pro zaměstnance ·' }} § 38 odst. 5 zákona č. 582/1991 Sb. ve znění do 31. 12. 2025{% if environment == 'test' %} · TESTOVACÍ PROSTŘEDÍ{% endif %}</div>

<table class="grid" style="margin-top:3mm">
  <tr>
    <td style="width:40%">
      <div class="label">Zaměstnavatel</div>
      <div class="value">{{ employer.name }}</div>
      {% if employer.identification_number != '' %}<div>IČ: {{ employer.identification_number }}</div>{% endif %}
      <div>Sídlo: {{ employer.address }}</div>
      <div>Variabilní symbol: {{ employer.variable_symbol }}</div>
    </td>
    <td style="width:35%">
      <div class="label">Občan</div>
      <div class="value">{{ employee.last_name }} {{ employee.first_name }}</div>
      <div>Rodné příjmení: {{ employee.birth_surname }}</div>
      {% if employee.birth_number is not null %}<div>Rodné číslo: {{ employee.birth_number }}</div>{% endif %}
      <div>Datum narození: {{ employee.birth_date|cz_date }}</div>
      <div>Místo narození: {{ employee.birth_place }}</div>
      <div>Trvalý pobyt: {{ employee.address }}</div>
    </td>
    <td>
      <div class="label">Typ ELDP</div>
      <div class="value">{{ eldp_type }}</div>
      {% if employed_from is not null %}<div>Výdělečná činnost od {{ employed_from|cz_date }}</div>{% endif %}
    </td>
  </tr>
</table>

<div class="section">Řádky evidenčního listu</div>
<table class="grid">
  <thead>
    <tr>
      <th>Kód</th><th>MR</th><th>Od</th><th>Do</th><th class="num">Dny</th><th>Měsíce bez pojištění (X)</th>
      <th class="num">Vyloučené doby</th><th class="num">Odečtené doby</th><th class="num">Vyměřovací základ (Kč)</th>
    </tr>
  </thead>
  <tbody>
  {% for section in sections %}
    <tr>
      <td>{{ section.code }}</td>
      <td>{{ section.small_scale }}</td>
      <td>{{ section.valid_from is not null ? section.valid_from|cz_date : '' }}</td>
      <td>{{ section.valid_to is not null ? section.valid_to|cz_date : '' }}</td>
      <td class="num">{{ section.insurance_days }}</td>
      <td>{{ section.whole_year_without_insurance ? '1-12' : (section.months_without_insurance is empty ? '' : section.months_without_insurance|join(', ')) }}</td>
      <td class="num">{{ section.excluded_days_total }}</td>
      <td class="num">{{ section.deducted_days_total }}</td>
      <td class="num">{{ section.assessment_base_czk|czk }}</td>
    </tr>
  {% endfor %}
    <tr>
      <td colspan="4"><strong>Celkem</strong></td>
      <td class="num"><strong>{{ totals.insurance_days }}</strong></td>
      <td></td>
      <td class="num"><strong>{{ totals.excluded_days_total }}</strong></td>
      <td class="num"><strong>{{ totals.deducted_days_total }}</strong></td>
      <td class="num"><strong>{{ totals.assessment_base_czk|czk }}</strong></td>
    </tr>
  </tbody>
</table>

{% if variant == 'employer' %}
<div class="note">
  Stejnopis odpovídá zmrazenému evidenčnímu listu č. {{ statement_id }}, který zaměstnavatel předkládá České správě
  sociálního zabezpečení. Zaměstnavatel ho předkládá pojištěnci k podpisu a ponechává si ho ve své evidenci tři
  kalendářní roky po roce, kterého se týká (§ 35a odst. 4 písm. a) zákona č. 582/1991 Sb.).
</div>

<table class="signature">
  <tr>
    <td>Datum vyhotovení: {{ prepared_on is not null ? prepared_on|cz_date : '' }}</td>
    <td><div class="line">Datum a podpis pojištěnce</div></td>
  </tr>
</table>
{% else %}
<div class="note">
  Stejnopis odpovídá zmrazenému evidenčnímu listu č. {{ statement_id }}, který zaměstnavatel předkládá České správě
  sociálního zabezpečení. Nesouhlasíte-li se zápisem a zaměstnavatel ho na vaši žádost neopraví, můžete do 30 dnů od
  převzetí stejnopisu požádat příslušnou územní správu sociálního zabezpečení o rozhodnutí sporu.
</div>

<table class="signature">
  <tr>
    <td>Datum vyhotovení: {{ prepared_on is not null ? prepared_on|cz_date : '' }}</td>
    <td><div class="line">Podpis pověřeného zaměstnance a razítko zaměstnavatele</div></td>
  </tr>
</table>
{% endif %}
<div class="mono">
Renderer: {{ renderer_version }}<br>
SHA-256 XML: {{ manifest_sha256 }}
</div>
</body>
</html>
