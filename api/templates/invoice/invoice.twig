{# MyInvoice.cz — PDF šablona faktury (mPDF + Twig) #}
{# Variables: invoice (full hydrated), supplier, client, bank, qr_data_uri, locale #}
<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<title></title>
<style>{{ css|raw }}</style>
</head>
<body>

{# Bankovní spojení v patičce každé strany (volba firmy, migrace 2198). Jen když by ho
   jinak tiskl platební panel (převod k úhradě), panel pak ukáže jen QR. Uhrazeno,
   hotově, kartou a vratka zůstávají beze změny. #}
{% set bank_in_footer = supplier.invoice_pdf_bank_in_footer|default(false) and bank and refund_amount is null
     and not is_paid and payment_method != 'card' and payment_method != 'cash' %}
{# ─── PAGE FOOTER (každá stránka) — attribution ─── #}
<htmlpagefooter name="attribution">
{% if bank_in_footer %}
  {% set _bank_parts = [] %}
  {% if bank.account_number %}{% set _bank_parts = _bank_parts|merge([bank.account_number ~ (bank.bank_code ? ' / ' ~ bank.bank_code : '')]) %}{% endif %}
  {% if bank.iban %}{% set _bank_parts = _bank_parts|merge(['IBAN: ' ~ bank.iban]) %}{% endif %}
  {% if bank.bic %}{% set _bank_parts = _bank_parts|merge(['BIC: ' ~ bank.bic]) %}{% endif %}
  {% if bank.bank_name %}{% set _bank_parts = _bank_parts|merge([bank.bank_name]) %}{% endif %}
  {% if _bank_parts is not empty %}<div class="page-bank">{{ t('Bankovní spojení', 'Bank account') }}: {{ _bank_parts|join(' · ') }}</div>{% endif %}
{% endif %}
  <div class="page-attribution">
    {% if locale == 'en' %}Powered by <a href="https://myucto.cz/">MyÚčto.cz</a> accounting system by <a href="https://mywebdesign.cz/">MyWebdesign.cz</a>{% else %}Používá účetní systém <a href="https://myucto.cz/">MyÚčto.cz</a> od <a href="https://mywebdesign.cz/">MyWebdesign.cz</a>{% endif %}
  </div>
</htmlpagefooter>
<sethtmlpagefooter name="attribution" value="on" />

{# ─── HLAVIČKA ─── #}
<table class="head{% if invoice.invoice_type == 'credit_note' %} credit-note{% elseif invoice.invoice_type == 'cancellation' %} cancellation{% endif %}">
  <tr>
    {% if logo_show_name and logo_path and logo_path is not empty %}
      {# Logo + název firmy: dvě SOUSEDNÍ buňky .head (žádná vnořená tabulka — ta v mPDF
         mazala spodní čáru hlavičky). Mezeru dělá pevná šířka buňky loga: mPDF na buňce
         respektuje `width`, ne padding. #}
      <td class="logo-img-cell"><img src="{{ logo_path }}" alt="logo" style="max-width: 16mm; max-height: 18mm;"></td>
      <td class="logo-name">{{ supplier.display_name|default(supplier.company_name) }}</td>
    {% else %}
      <td class="logo">
        {% if logo_path and logo_path is not empty %}
          <img src="{{ logo_path }}" alt="logo" style="max-width: 72mm; max-height: 20mm;">
        {% else %}
          <div class="brand-name">{{ supplier.company_name }}</div>
        {% endif %}
      </td>
    {% endif %}
    <td class="meta">
      <div class="doc-type">{{ doc_type_label }}</div>
      {% if invoice.varsymbol %}
        <div class="varsymbol-big">{{ invoice.varsymbol }}</div>
      {% endif %}
      {% if parent_varsymbol %}
        <div class="parent-ref">{{ t('k faktuře', 'to invoice') }} {{ parent_varsymbol }}</div>
      {% endif %}
      {% if isdoc_attachment %}
        {# Vizuální badge — samotný embedded ISDOC soubor přidává mPDF přes
           SetAssociatedFiles() v PDF/A-3 /AF + /Names /EmbeddedFiles. Klikatelná
           paperclip annotation tady BYLA, ale duplikovala přílohu pod sanitizovaným
           filename (mPDF si dělá embed lokálně z file= cesty), takže ji zde nemáme. #}
        <div class="isdoc-badge">ISDOC</div>
      {% endif %}
    </td>
  </tr>
</table>

{# ─── STRANY ─── #}
<table class="parties">
  <tr>
    <td>
      <h2>{{ t('Dodavatel', 'Supplier') }}</h2>
      <div class="spacer-3">&nbsp;</div>
      <div class="party-name">{{ supplier.company_name }}</div>
      {% if supplier.display_name and supplier.display_name != supplier.company_name %}
        <div>{{ supplier.display_name }}</div>
      {% endif %}
      <div>{{ supplier.street }}</div>
      <div>{{ supplier.zip }} {{ supplier.city }}</div>
      <div>{{ locale == 'en' ? supplier.country_name_en : supplier.country_name_cs }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {% if supplier.ic %}{{ t('IČO', 'Reg. No.') }}: {{ supplier.ic }}<br>{% endif %}
        {# SK plátce DPH (#120): DIČ s prefixem SK je „IČ DPH"; vedle něj patří DIČ = totéž bez
           prefixu (supplier skdic nevede, SK DIČ se od IČ DPH liší jen prefixem). Neplátce má
           v poli jen číslo bez prefixu → spadne do else a tiskne se jako DIČ. #}
        {% if supplier.dic %}
          {% if supplier.dic|upper starts with 'SK' %}
            {{ t('DIČ', 'Tax ID') }}: {{ supplier.dic|slice(2) }}<br>
            {{ t('IČ DPH', 'VAT ID') }}: {{ supplier.dic }}
          {% else %}
            {{ t('DIČ', 'VAT ID') }}: {{ supplier.dic }}
          {% endif %}
        {% endif %}
      </div>
    </td>
    {# Zjednodušený doklad (§ 30) bez odběratele: systémový koncový zákazník se netiskne,
       buňka odběratele se nevykreslí vůbec (prázdný barevný box by působil jako chyba).
       Totéž při volbě „netisknout odběratele" na zjednodušeném dokladu (hide_customer). #}
    {% if not client.is_walk_in|default(false) and not hide_customer|default(false) %}
    <td class="party-customer">
      <h2>{{ t('Odběratel', 'Customer') }}</h2>
      <div class="spacer-3">&nbsp;</div>
      <div class="party-name">{{ client.company_name }}</div>
      {% if client.first_name or client.last_name %}
        <div>{{ client.first_name }} {{ client.last_name }}</div>
      {% endif %}
      <div>{{ client.street }}</div>
      <div>{{ client.zip }} {{ client.city }}</div>
      <div>{{ locale == 'en' ? client.country_name_en : client.country_name_cs }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {# Národní daňové číslo (#120): SK DIČ / DE+AT Steuernummer / PL NIP / HU Adószám —
           nativní label podle země klienta. `dic` zůstává VAT ID s prefixem (u SK = IČ DPH,
           u SK se proto VAT řádek labeluje „IČ DPH"). Pořadí dle SK praxe: IČO, DIČ, IČ DPH.
           Starší SK snapshoty tax_number nemají → odvodíme z IČ DPH oseknutím prefixu
           (SK DIČ se od IČ DPH liší jen prefixem; u DE/PL/HU odvodit nejde). #}
        {% set tax_no_labels = {'SK': 'DIČ', 'DE': 'Steuernummer', 'AT': 'Steuernummer', 'PL': 'NIP', 'HU': 'Adószám'} %}
        {% set client_dic_sk = client.dic and (client.dic|upper starts with 'SK') %}
        {% set client_tax_no = client.tax_number|default(client_dic_sk ? client.dic|slice(2) : '') %}
        {% if client.ic %}{{ t('IČO', 'Reg. No.') }}: {{ client.ic }}<br>{% endif %}
        {% if client_tax_no %}
          {{ tax_no_labels[client.country_iso2|default('')]|default(client_dic_sk ? 'DIČ' : t('Daňové číslo', 'Tax No.')) }}: {{ client_tax_no }}{% if client.dic %}<br>{% endif %}
        {% endif %}
        {% if client.dic %}
          {{ client_dic_sk ? t('IČ DPH', 'VAT ID') : t('DIČ', 'VAT ID') }}: {{ client.dic }}
        {% endif %}
      </div>
    </td>
    {% endif %}
  </tr>
</table>

{# ─── METADATA ─── #}
<table class="meta-grid">
  <tr>
    <td class="meta-label">{{ t('Vystaveno', 'Issued') }}</td>
    <td class="meta-value">{{ invoice.issue_date|date(date_format) }}</td>
    <td class="meta-label">{{ t('Var. symbol', 'Var. symbol') }}</td>
    <td class="meta-value mono">{{ payment_varsymbol|default(invoice.varsymbol)|default('—') }}</td>
  </tr>
  {# Identifikovaná osoba (§ 6g–6l, #94) na zahraničním RC dokladu řádek
     „Není plátce DPH" nemá — matl by příjemce, který má daň samovyměřit;
     nahrazuje ho RC klauzule + DIČ. Tuzemské faktury IO řádek mají (pravdivý). #}
  {% if not supplier.is_vat_payer and not (supplier.is_identified|default(false) and invoice.reverse_charge) %}
  <tr>
    <td class="meta-label">{{ t('DPH', 'VAT') }}</td>
    <td class="meta-value" colspan="3">{{ t('Není plátce DPH', 'Not a VAT payer') }}</td>
  </tr>
  {% elseif supplier.is_vat_payer and invoice.invoice_type in ['rent_calendar', 'advance_calendar'] %}
  {# Kalendář nemá společné DUZP: u nájmu ho nese každá splátka (§ 21 odst. 7), u záloh žádné není (§ 31a odst. 2). #}
  <tr>
    <td class="meta-label">{{ invoice.calendar_contract_ref ? t('Smlouva', 'Contract') : '' }}</td>
    <td class="meta-value">{{ invoice.calendar_contract_ref }}</td>
    <td class="meta-label">{{ t('KS', 'Const. symbol') }}</td>
    <td class="meta-value mono">0308</td>
  </tr>
  {% elseif supplier.is_vat_payer and invoice.tax_date and invoice.invoice_type != 'proforma' %}
  <tr>
    <td class="meta-label">{{ t('DUZP', 'Tax point') }}</td>
    <td class="meta-value">{{ invoice.tax_date|date(date_format) }}</td>
    <td class="meta-label">{{ t('KS', 'Const. symbol') }}</td>
    <td class="meta-value mono">0308</td>
  </tr>
  {% endif %}
  <tr>
    <td class="meta-label">{{ t('Splatnost', 'Due') }}</td>
    <td class="meta-value">{{ invoice.due_date|date(date_format) }}</td>
    <td class="meta-label">{{ t('Měna', 'Currency') }}</td>
    <td class="meta-value mono">{{ invoice.currency }}</td>
  </tr>
  <tr>
    <td class="meta-label">{{ t('Úhrada', 'Payment') }}</td>
    <td class="meta-value">
      {%- if payment_method == 'card' -%}{{ t('Platební karta', 'Card') }}
      {%- elseif payment_method == 'cash' -%}{{ t('Hotově', 'Cash') }}
      {%- elseif payment_method == 'other' -%}{{ t('Jiný způsob', 'Other') }}
      {%- else -%}{{ t('Bankovní převod', 'Bank transfer') }}{%- endif -%}
    </td>
    {% if invoice.project_name %}
      <td class="meta-label">{{ t('Zakázka', 'Project') }}</td>
      <td class="meta-value">{{ invoice.project_name }}</td>
    {% else %}
      <td></td><td></td>
    {% endif %}
  </tr>
  {% if invoice.project_number or invoice.contract_number %}
  <tr>
    {% if invoice.project_number %}
      <td class="meta-label">{{ t('Vaše číslo', 'Your order no.') }}</td>
      <td class="meta-value mono">{{ invoice.project_number }}</td>
    {% else %}
      <td></td><td></td>
    {% endif %}
    {% if invoice.contract_number %}
      <td class="meta-label">{{ t('Vaše smlouva', 'Your contract') }}</td>
      <td class="meta-value mono">{{ invoice.contract_number }}</td>
    {% else %}
      <td></td><td></td>
    {% endif %}
  </tr>
  {% endif %}
  {# Doklady z prodejní objednávky a převzaté migrací 1703 nesou číslo i v poznámce
     („Objednávka: …") — tam ho podruhé netiskneme. #}
  {% if invoice.supplier_order_number and ('Objednávka: ' ~ invoice.supplier_order_number) not in invoice.note_below_items|default('') %}
  <tr>
    <td class="meta-label">{{ t('Objednávka', 'Order no.') }}</td>
    <td class="meta-value mono" colspan="3">{{ invoice.supplier_order_number }}</td>
  </tr>
  {% endif %}
  {# Kdo doklad vystavil, jen se zapnutou volbou firmy (InvoicePdfRenderer::issuedByLabel). #}
  {% if issued_by_label %}
  <tr>
    <td class="meta-label">{{ t('Vystavil', 'Issued by') }}</td>
    <td class="meta-value" colspan="3">{{ issued_by_label }}</td>
  </tr>
  {% endif %}
</table>

{% if invoice.note_above_items %}
<div class="note">{{ invoice.note_above_items|nl2br }}</div>
{% endif %}

{# ─── POLOŽKY ─── #}
{# Kompaktní řádky (volba firmy, migrace 2196): menší odsazení a písmo, víc řádků na stranu. #}
{% set compact_items = supplier.invoice_pdf_compact_items|default(false) %}
<table class="items{% if line_discount_columns|default(false) %} items-ld{% endif %}{% if compact_items %} items-compact{% endif %}">
  <thead>
    <tr>
      {# Sleva z ceníkové ceny (migrace 2035, volba firmy): tři cenové sloupce místo
         jednoho. Jen když ji má aspoň jeden řádek, jinak tabulka beze změny.
         Kompaktní řádky dávají popisu víc šířky na úkor rezervy číselných sloupců:
         užší popis se lámal na víc řádků a ty určovaly výšku řádku. #}
      {% if line_discount_columns|default(false) %}
      {% if supplier.is_vat_payer %}
      <th style="width:{{ compact_items ? '25%' : '20%' }}">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '5.5%' : '5.5%' }}">{{ t('Mn.', 'Qty') }}</th>
      <th class="nowrap" style="width:{{ compact_items ? '5.5%' : '5.5%' }}">{{ t('Jed.', 'Unit') }}</th>
      <th class="num" style="width:{{ compact_items ? '12%' : '13%' }}">{{ t('Cena/j před slevou', 'Unit price before discount') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '8%' : '8%' }}">{{ t('Sleva', 'Discount') }}</th>
      <th class="num" style="width:{{ compact_items ? '12%' : '13%' }}">{{ t('Cena/j po slevě', 'Unit price after discount') }}</th>
      <th class="center nowrap vat" style="width:{{ compact_items ? '5%' : '6%' }}">{{ t('DPH', 'VAT') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '13.5%' : '14.5%' }}">{{ t('Bez DPH', 'Without VAT') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '13.5%' : '14.5%' }}">{{ t('S DPH', 'With VAT') }}</th>
      {% else %}
      <th style="width:{{ compact_items ? '40%' : '27%' }}">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '6%' : '7%' }}">{{ t('Mn.', 'Qty') }}</th>
      <th class="nowrap" style="width:{{ compact_items ? '6%' : '6%' }}">{{ t('Jed.', 'Unit') }}</th>
      <th class="num" style="width:{{ compact_items ? '12.5%' : '15%' }}">{{ t('Cena/j před slevou', 'Unit price before discount') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '8%' : '9%' }}">{{ t('Sleva', 'Discount') }}</th>
      <th class="num" style="width:{{ compact_items ? '12.5%' : '15%' }}">{{ t('Cena/j po slevě', 'Unit price after discount') }}</th>
      {% if invoice.reverse_charge %}
      <th class="num nowrap" style="width:{{ compact_items ? '15%' : '21%' }}">{{ t('Celkem bez DPH', 'Total excl. VAT') }}</th>
      {% else %}
      <th class="num nowrap" style="width:{{ compact_items ? '15%' : '21%' }}">{{ t('Celkem', 'Total') }}</th>
      {% endif %}
      {% endif %}
      {% elseif supplier.is_vat_payer %}
      <th style="width:{{ compact_items ? '42%' : '30%' }}">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '6.5%' : '7%' }}">{{ t('Mn.', 'Qty') }}</th>
      <th class="nowrap" style="width:{{ compact_items ? '6%' : '7%' }}">{{ t('Jed.', 'Unit') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '12%' : '15%' }}">{{ t('Cena/j', 'Price/unit') }}</th>
      <th class="center nowrap vat" style="width:{{ compact_items ? '6%' : '8%' }}">{{ t('DPH', 'VAT') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '13.5%' : '16%' }}">{{ t('Bez DPH', 'Without VAT') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '14%' : '17%' }}">{{ t('S DPH', 'With VAT') }}</th>
      {% else %}
      <th style="width:{{ compact_items ? '58%' : '42%' }}">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '7%' : '9%' }}">{{ t('Mn.', 'Qty') }}</th>
      <th class="nowrap" style="width:{{ compact_items ? '7%' : '8%' }}">{{ t('Jed.', 'Unit') }}</th>
      <th class="num nowrap" style="width:{{ compact_items ? '13%' : '18%' }}">{{ t('Cena/j', 'Price/unit') }}</th>
      {# RC doklad neplátce/IO: částky jsou základ daně (samovyměří odběratel) —
         sloupec to musí říct, neutrální „Celkem" by byl nejednoznačný. #}
      {% if invoice.reverse_charge %}
      <th class="num nowrap" style="width:{{ compact_items ? '15%' : '23%' }}">{{ t('Celkem bez DPH', 'Total excl. VAT') }}</th>
      {% else %}
      <th class="num nowrap" style="width:{{ compact_items ? '15%' : '23%' }}">{{ t('Celkem', 'Total') }}</th>
      {% endif %}
      {% endif %}
    </tr>
  </thead>
  <tbody>
    {% for item in invoice.items %}
    {# Textový řádek (item_kind 'text'): jen popis přes celou šířku tabulky, bez částek. #}
    {% if item.item_kind == 'text' %}
    <tr class="text-row">
      <td colspan="{{ (supplier.is_vat_payer ? 7 : 5) + (line_discount_columns|default(false) ? 2 : 0) }}">{{ item.description|nl2br }}</td>
    </tr>
    {% else %}
    <tr{% if item.item_kind == 'discount' %} class="discount-row"{% endif %}>
      {# Když má faktura výkaz víceprací, je proklikávací (podtržený) odkaz na stránku
         s výkazem JEN položka výkazu — tj. ta, jejíž popis odpovídá názvu výkazu
         (work_report.title), s pojistkou na klíčové slovo „výkaz" / „work report".
         Ostatní položky i slevové řádky zůstávají běžným textem. mPDF dělá interní
         skok na <a name="work-report">. #}
      {%- set _wr_d = item.description|trim|lower -%}
      {%- set _mat_title = work_report.material_title|default('')|trim|lower -%}
      {%- set _is_mat_item = work_report and work_report.material_total > 0 and item.item_kind != 'discount'
            and _mat_title != '' and _wr_d == _mat_title -%}
      {%- set _is_wr_item = work_report and not _is_mat_item and item.item_kind != 'discount'
            and (_wr_d == (work_report.title|default('')|trim|lower)
                 or 'výkaz' in _wr_d or 'work report' in _wr_d) -%}
      {%- set _base_qty = item.base_qty is defined and item.base_qty is not null
            ? item.base_qty|number_format(item.base_qty == item.base_qty|round(0) ? 0 : (item.base_qty == item.base_qty|round(1) ? 1 : (item.base_qty == item.base_qty|round(2) ? 2 : 3)), decimal_sep, thousand_sep)
            : null -%}
      <td>
        {%- if _is_wr_item -%}
          <a href="#work-report" class="wr-link">{{ item.description|nl2br }}</a>
        {%- elseif _is_mat_item -%}
          <a href="#work-report-material" class="wr-link">{{ item.description|nl2br }}</a>
        {%- else -%}
          {{ item.description|nl2br }}
        {%- endif -%}
        {#- Kompaktní řádky tisknou rozpis balení a sériová čísla za popisem na stejném
            řádku: v úzkém sloupci jednotky by se rozpis lámal na několik řádků. -#}
        {%- if compact_items and _base_qty is not null -%}<span style="font-size:85%;color:#666666;white-space:nowrap"> · {{ t('celkem', 'total') }}&nbsp;{{ _base_qty }}&nbsp;{{ item.base_unit }}</span>{%- endif -%}
        {#- Vybraná sériová čísla a šarže (InvoicePdfRenderer::withTrackingLines). -#}
        {%- for tracking_line in item.tracking_lines|default([]) -%}
          {#- Popisek („Výr. č.:“) drží pevnými mezerami u prvního čísla, na konci řádku se neodtrhne. -#}
          {%- if compact_items -%}{%- set _tl = tracking_line|split(': ', 2) -%}
            <span style="font-size:85%;color:#666666"> · {% if _tl|length == 2 %}{{ _tl[0]|e|replace({' ': '&nbsp;'})|raw }}:&nbsp;{{ _tl[1] }}{% else %}{{ tracking_line }}{% endif %}</span>
          {%- else -%}<br><span style="font-size:85%;color:#666666">{{ tracking_line }}</span>{%- endif -%}
        {%- endfor -%}
      </td>
      {% if item.item_kind == 'discount' %}
      <td></td><td></td><td></td>
      {%- if line_discount_columns|default(false) %}<td></td><td></td>{% endif %}
      {% else %}
      <td class="num nowrap">{% if item.duration_display is defined and item.duration_display is not null %}{{ item.duration_display }}{% else %}{{ item.quantity|number_format(item.quantity_decimals ?? (item.quantity == item.quantity|round(0) ? 0 : (item.quantity == item.quantity|round(1) ? 1 : (item.quantity == item.quantity|round(2) ? 2 : 3))), decimal_sep, thousand_sep) }}{% endif %}</td>
      {# Balení (issue #17): řádek v kartonech dostane rozpis na základní jednotky
         karty, pokud ho firma nemá v nastavení vypnutý (InvoicePdfRenderer::withBaseQuantity). #}
      <td>{{ item.unit }}{% if _base_qty is not null and not compact_items %}<br><span style="font-size:85%;color:#666666;white-space:nowrap">({{ t('celkem', 'total') }} {{ _base_qty }}&nbsp;{{ item.base_unit }})</span>{% endif %}</td>
      {# V režimu „ceny s DPH" nese unit_price_without_vat brutto; pro zobrazení dopočítáme
         skutečné netto z řádkového základu (total_without_vat / množství). #}
      {% if line_discount_columns|default(false) %}
      {# Přirážka a řádek bez slevy tisknou jen výslednou cenu. #}
      {% if item.pdf_list_unit_price is defined %}
      <td class="num nowrap">{{ item.pdf_list_unit_price|number_format(item.unit_price_decimals|default(2), decimal_sep, thousand_sep) }}</td>
      <td class="num nowrap">{{ item.pdf_discount_label }}&nbsp;%</td>
      {% else %}
      <td></td><td></td>
      {% endif %}
      {% endif %}
      <td class="num nowrap">{{ item.pdf_unit_price|default(invoice.prices_include_vat and item.quantity != 0 ? item.total_without_vat / item.quantity : item.unit_price_without_vat)|number_format(item.unit_price_decimals|default(2), decimal_sep, thousand_sep) }}</td>
      {% endif %}
      {% if supplier.is_vat_payer %}
      <td class="center nowrap vat">{{ item.vat_rate_snapshot|number_format(item.vat_rate_snapshot == item.vat_rate_snapshot|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
      <td class="num nowrap">{{ item.total_without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      <td class="num nowrap">{{ item.total_with_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      {% else %}
      <td class="num nowrap">{{ item.total_without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      {% endif %}
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>

{% if invoice.reverse_charge %}
<div class="note rc-note">
  {# Tuzemský RC mezi plátci = § 92a ZDPH; přeshraniční plnění (klient mimo CZ,
     vč. faktur identifikované osoby do EU) = čl. 196 směrnice 2006/112/ES. #}
  {% if client.country_iso2|default('CZ') == 'CZ' %}
  {{ t('Daň odvede zákazník (přenesená daňová povinnost dle § 92a zákona o DPH).',
       'Reverse charge — VAT to be accounted for by the customer.') }}
  {% else %}
  {{ t('Daň odvede zákazník (přenesení daňové povinnosti dle čl. 196 směrnice 2006/112/ES).',
       'Reverse charge — VAT to be accounted for by the customer pursuant to Article 196 of Council Directive 2006/112/EC.') }}
  {% endif %}
</div>
{% endif %}

{# ─── OSS DOLOŽKA ───
   Doklad s řádky v režimu jednoho správního místa nese sazbu státu spotřeby. Bez téhle
   věty ji příjemce ani jeho účetní nemá jak odlišit od české daně ve špatné sazbě —
   doložka je protějškem RC klauzule výše. Podklad staví OssInvoiceClause (SSOT sdílený
   s veřejným HTML náhledem).
   Doklad se smíšeným plněním (část tuzemská, část OSS) dostane opatrnější formulaci —
   tvrdit u něj, že daň je odvedena ve státě spotřeby, by platilo jen o části řádků.
   Státy spotřeby se vypisují všechny; seznam je buď úplný, nebo (u řádku bez země)
   prázdný a věta státy nejmenuje — neúplný výčet by na dokladu lhal. #}
{% if oss_clause %}
<div class="note oss-note">
  {% if oss_clause.all_items %}
  {{ t('Daň je přiznána a odvedena ve státě spotřeby v režimu jednoho správního místa (One Stop Shop) podle § 110a a násl. zákona o DPH.',
       'VAT is declared and paid in the Member State of consumption under the One Stop Shop scheme pursuant to Articles 369a et seq. of Council Directive 2006/112/EC.') }}
  {% else %}
  {{ t('U položek v režimu jednoho správního místa (One Stop Shop) je daň přiznána a odvedena ve státě spotřeby podle § 110a a násl. zákona o DPH.',
       'For the items covered by the One Stop Shop scheme, VAT is declared and paid in the Member State of consumption pursuant to Articles 369a et seq. of Council Directive 2006/112/EC.') }}
  {% endif %}
  {% if oss_clause.countries is not empty %}
    {#- Řízení bílých znaků (`{%-`) drží popisek a výčet států na jednom řádku —
        bez něj mPDF vysází „Stát spotřeby:" a název státu s mezerou navíc. -#}
    {%- if oss_clause.countries|length > 1 %} {{ t('Státy spotřeby', 'Member States of consumption') }}:
    {%- else %} {{ t('Stát spotřeby', 'Member State of consumption') }}:
    {%- endif %}
    {%- for c in oss_clause.countries %} {{ locale == 'en' ? c.name_en : c.name_cs }}{{ loop.last ? '.' : ',' }}{% endfor %}
  {% endif %}
</div>
{% endif %}

{# ─── SUMACE + QR/BANK ─── #}
<table class="totals">
  <tr>
    <td class="left">
      {# QR + bankovní spojení sloučené do jednoho podbarveného „platebního" panelu —
         vizuální kotva dokladu. Renderuje se jen když je co platit/ukázat. #}
      {% set _has_pay = qr_data_uri or is_paid or payment_method == 'card' or payment_method == 'cash' or (bank and not bank_in_footer) or refund_amount is not null %}
      {% if _has_pay %}
      <table class="pay-panel{% if is_paid %} pay-panel-paid{% endif %}{% if bank_in_footer %} pay-panel-qr{% endif %}">
        <tr>
          {% if qr_data_uri and refund_amount is null %}
          <td class="pay-qr">
            <img src="{{ qr_data_uri }}" alt="QR" width="105" height="105">
{% if bank_in_footer %}
            <br><span class="bank-label">{{ t('QR platba', 'QR payment') }}</span>
{% endif %}
          </td>
          {% endif %}
{% if not bank_in_footer %}
          <td class="pay-info">
            {% if refund_amount is not null %}
              {# Vyúčtování s výsledkem k vyplacení: peníze posíláme my, takže žádné
                 platební údaje k úhradě ani QR. #}
              {% set _vs = payment_varsymbol|default(invoice.varsymbol) %}
              <div class="bank-label{% if is_paid %} paid-mark{% endif %}">
                {%- if is_paid %}{{ t('VRÁCENO', 'REFUNDED') }}{% else %}{{ t('K vrácení', 'Amount to be refunded') }}{% endif -%}
              </div>
              <div class="spacer-3">&nbsp;</div>
              <div class="bank-value{% if is_paid %} paid-mark{% endif %}">{{ refund_amount|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</div>
              <div class="spacer-2">&nbsp;</div>
              <div class="bank-meta-line">
                {%- if payment_method == 'cash' -%}
                  {%- if is_paid %}{{ t('Vyplaceno v hotovosti.', 'Paid out in cash.') }}{% else %}{{ t('Částku vám vyplatíme v hotovosti.', 'We will pay the amount out to you in cash.') }}{% endif -%}
                {%- elseif is_paid -%}
                  {{ t('Částka vám byla vrácena převodem.', 'The amount has been refunded to you by bank transfer.') }}
                {%- else -%}
                  {{ t('Částku vám vrátíme převodem pod variabilním symbolem', 'We will refund the amount by bank transfer under variable symbol') }} <span style="font-family:'geistmono',monospace;color:#15131D;">{{ _vs }}</span>.
                {%- endif -%}
              </div>
              {% if is_paid and invoice.paid_at %}
                <div class="bank-meta-line">{{ t('Datum vrácení', 'Refunded on') }}: {{ invoice.paid_at|date(date_format) }}</div>
              {% endif %}
            {% elseif is_paid %}
              <div class="bank-label paid-mark" style="margin-bottom:1.5mm;">{{ t('UHRAZENO', 'PAID') }}</div>
              <div class="bank-value paid-mark">
                {%- if payment_method == 'card' -%}{{ t('Platba kartou online', 'Paid online by card') }}
                {%- elseif payment_method == 'cash' -%}{{ t('Hotově', 'Cash') }}
                {%- else -%}{{ t('Neplaťte prosím znovu', 'Do not pay again') }}{%- endif -%}
              </div>
              {% if invoice.paid_at %}
                <div class="spacer-2">&nbsp;</div>
                <div class="bank-meta-line">{{ t('Datum úhrady', 'Paid on') }}: {{ invoice.paid_at|date(date_format) }}</div>
              {% endif %}
            {% elseif payment_method == 'card' %}
              <div class="bank-label">{{ t('Způsob úhrady', 'Payment method') }}</div>
              <div class="spacer-3">&nbsp;</div>
              <div class="bank-value">{{ t('Platební karta', 'Card') }}</div>
              <div class="spacer-2">&nbsp;</div>
              <div class="bank-meta-line">{{ t('Bankovní převod ani QR se nepoužije.', 'Bank transfer and QR are not used.') }}</div>
            {% elseif payment_method == 'cash' %}
              <div class="bank-label">{{ t('Způsob úhrady', 'Payment method') }}</div>
              <div class="spacer-3">&nbsp;</div>
              <div class="bank-value">{{ t('Hotově', 'Cash') }}</div>
            {% elseif bank %}
              <div class="bank-label">{{ t('Bankovní spojení', 'Bank account') }}</div>
              <div class="spacer-3">&nbsp;</div>
              {% if bank.account_number %}
                <div class="bank-value">{{ bank.account_number }}{% if bank.bank_code %} / {{ bank.bank_code }}{% endif %}</div>
              {% endif %}
              {% if bank.iban %}
                <div class="bank-value">{{ bank.iban }}</div>
              {% endif %}
              {% set _vs = payment_varsymbol|default(invoice.varsymbol) %}
              {% if _vs %}
                <div class="bank-meta-line">{{ t('Var. symbol', 'Var. symbol') }}: <span style="font-family:'geistmono',monospace;color:#15131D;">{{ _vs }}</span></div>
              {% endif %}
              {% if bank.bic or bank.bank_name %}
                <div class="spacer-2">&nbsp;</div>
              {% endif %}
              {% if bank.bic %}
                <div class="bank-meta-line">BIC: {{ bank.bic }}</div>
              {% endif %}
              {% if bank.bank_name %}
                <div class="bank-meta-line">{{ t('Banka', 'Bank') }}: {{ bank.bank_name }}</div>
              {% endif %}
            {% endif %}
          </td>
{% endif %}
        </tr>
      </table>
      {% endif %}
    </td>
    <td class="right">
      <table class="totals-table">
        {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' %}
        {% for b in invoice.vat_breakdown %}
        <tr>
          <td class="tot-label">{{ t('Základ', 'Base') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
          <td class="tot-num nowrap">{{ b.base|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% if b.vat > 0 %}
        <tr>
          <td class="tot-label">{{ t('DPH', 'VAT') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
          <td class="tot-num nowrap">{{ b.vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {% endfor %}
        {# Souhrn jen při více sazbách; u jediné sazby by jen zopakoval per-sazbové řádky výše #}
        {% if invoice.vat_breakdown|length > 1 %}
        <tr class="subtotal">
          <td class="tot-label">{{ t('Celkem bez DPH', 'Total without VAT') }}</td>
          <td class="tot-num nowrap">{{ invoice.totals.without_vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        <tr class="subtotal">
          <td class="tot-label">{{ t('DPH celkem', 'Total VAT') }}</td>
          <td class="tot-num nowrap">{{ invoice.totals.vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {% endif %}
        {% if invoice.totals.rounding|default(0) != 0 %}
        <tr>
          <td class="tot-label">{{ t('Zaokrouhlení', 'Rounding') }}</td>
          <td class="tot-num nowrap">{{ invoice.totals.rounding|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        <tr class="grand">
          <td class="tot-label">{{ t('Celkem', 'Total') }}</td>
          <td class="tot-num nowrap">{{ invoice.totals.with_vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% if invoice.advance_paid_amount > 0 %}
        <tr class="advance">
          {% if invoice.invoice_type == 'tax_document' %}
          {# Daňový doklad k přijaté platbě — „záloha" je sama přijatá platba. #}
          <td class="tot-label">{{ t('Uhrazeno přijatou platbou', 'Settled by payment received') }}</td>
          {% else %}
          <td class="tot-label">{{ t('Odečet zálohy', 'Advance deduction') }}</td>
          {% endif %}
          <td class="tot-num nowrap">−{{ invoice.advance_paid_amount|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% if refund_amount is null %}
        <tr class="to-pay">
          <td class="tot-label">{{ t('K úhradě', 'Amount due') }}</td>
          <td class="tot-num nowrap">{{ invoice.amount_to_pay|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {% endif %}
        {% if refund_amount is not null %}
        <tr class="to-pay">
          <td class="tot-label">{{ t('K vrácení', 'Amount to be refunded') }}</td>
          <td class="tot-num nowrap">{{ refund_amount|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {# Částečné úhrady (#89): evidované platby snižují výzvu k platbě — znovu
           stažené PDF nesmí chtít celou částku (QR výše zní na tentýž zbytek). #}
        {% if (invoice.paid_total ?? 0) > 0 and not is_paid %}
        <tr class="advance">
          <td class="tot-label">{{ t('Uhrazeno', 'Paid to date') }}</td>
          <td class="tot-num nowrap">−{{ invoice.paid_total|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        <tr class="to-pay">
          <td class="tot-label">{{ t('Zbývá uhradit', 'Remaining amount due') }}</td>
          <td class="tot-num nowrap">{{ (invoice.amount_to_pay - invoice.paid_total)|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {% if invoice.czk_recap and not hide_pdf_czk_recap %}
        <tr class="rate-note">
          <td colspan="2" class="rate-note-cell">
            {{ t('Kurz ČNB', 'CNB rate') }}:
            {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }}
            ({{ invoice.czk_recap.rate_date }})
          </td>
        </tr>
        {% endif %}
        {% for b in pdf_czk_vat %}
        <tr class="vat-czk-required">
          <td class="tot-label">
            {{ t('DPH v CZK', 'VAT in CZK') }}
            ({{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%)
          </td>
          <td class="tot-num nowrap">{{ b.vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
        </tr>
        {% endfor %}
      </table>
    </td>
  </tr>
</table>

{% if invoice.czk_recap and not hide_pdf_czk_recap %}
<table class="czk-recap">
  <tr>
    <td colspan="2" class="czk-recap-title">
      {{ t('Přepočet do CZK', 'Conversion to CZK') }}
      <span class="czk-recap-rate">
        {{ t('kurz ČNB', 'CNB rate') }}:
        {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }}
        ({{ invoice.czk_recap.rate_date }})
      </span>
    </td>
  </tr>
  {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' %}
  {% for b in invoice.czk_recap.breakdown %}
  <tr>
    <td class="tot-label">{{ t('Základ', 'Base') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
    <td class="tot-num nowrap">{{ b.base_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% if b.vat_czk > 0 %}
  <tr>
    <td class="tot-label">{{ t('DPH', 'VAT') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
    <td class="tot-num nowrap">{{ b.vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% endif %}
  {% endfor %}
  {% if invoice.czk_recap.breakdown|length > 1 %}
  <tr class="subtotal">
    <td class="tot-label">{{ t('Celkem bez DPH', 'Total without VAT') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_without_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  <tr class="subtotal">
    <td class="tot-label">{{ t('DPH celkem', 'Total VAT') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% endif %}
  {% endif %}
  <tr class="grand">
    <td class="tot-label">{{ t('Celkem', 'Total') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_with_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
</table>
{% endif %}

{# ─── ROZPIS PLATEB (§ 31a ZDPH) ───
   Právě tenhle rozpis dělá z platebního kalendáře daňový doklad. Bez něj se doklad
   tiskl jako běžná faktura s jediným datem splatnosti — tedy bez toho jediného, kvůli
   čemu vzniká. Kalendář BEZ rozpisu se ani nedá vystavit (validace při vystavení), takže
   prázdná tabulka tady znamená doklad v konceptu; vypíše se proto věta, ne prázdný rám. #}
{% if invoice.invoice_type in ['payment_calendar', 'rent_calendar', 'advance_calendar'] %}
{% set is_rent_calendar = invoice.invoice_type == 'rent_calendar' %}
{% set schedule_columns = is_rent_calendar ? 6 : 5 %}
<table class="schedule-table">
  <tr>
    <td colspan="{{ schedule_columns }}" class="schedule-title">
      {{ t('Rozpis plateb', 'Payment schedule') }}
      <span class="schedule-legal">{{ is_rent_calendar ? t('§ 31 zákona o DPH', 'Section 31 of the Czech VAT Act') : t('§ 31a zákona o DPH', 'Section 31a of the Czech VAT Act') }}</span>
    </td>
  </tr>
  {% if payment_schedule is empty %}
  <tr>
    <td colspan="{{ schedule_columns }}" class="schedule-empty">
      {{ t('Rozpis plateb zatím není vyplněn.', 'The payment schedule has not been filled in yet.') }}
    </td>
  </tr>
  {% else %}
  <tr class="schedule-head">
    {% if is_rent_calendar %}<th class="schedule-th">{{ t('DUZP', 'Tax point') }}</th>{% endif %}
    <th class="schedule-th">{{ t('Splatnost', 'Due date') }}</th>
    <th class="schedule-th right">{{ t('Základ', 'Base') }}</th>
    <th class="schedule-th right">{{ t('DPH', 'VAT') }}</th>
    <th class="schedule-th right">{{ t('Celkem', 'Total') }}</th>
    <th class="schedule-th">{{ t('Poznámka', 'Note') }}</th>
  </tr>
  {% for row in payment_schedule %}
  <tr>
    {% if is_rent_calendar %}<td class="schedule-td nowrap">{{ (row.tax_date ?: row.due_on)|date(date_format) }}</td>{% endif %}
    <td class="schedule-td nowrap">{{ row.due_on|date(date_format) }}</td>
    <td class="schedule-td right nowrap">{{ row.base_amount|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ row.vat_amount|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ row.total_amount|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    <td class="schedule-td">{{ row.note }}</td>
  </tr>
  {% endfor %}
  <tr class="schedule-total">
    <td class="schedule-td"{% if is_rent_calendar %} colspan="2"{% endif %}>{{ t('Celkem za období', 'Total for the period') }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.base_amount, 0)|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.vat_amount, 0)|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.total_amount, 0)|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    <td class="schedule-td"></td>
  </tr>
  {% endif %}
</table>
<div class="note schedule-note">
  {% if is_rent_calendar %}
  {{ t('Každá splátka je samostatným dílčím plněním. Daň vzniká ke dni uskutečnění uvedenému u splátky, nebo dnem přijetí úplaty, pokud nastane dříve.',
       'Each instalment is a separate partial supply. VAT arises on the tax point stated for the instalment, or on receipt of payment if earlier.') }}
  {% elseif invoice.invoice_type == 'advance_calendar' %}
  {{ t('Daň vzniká dnem přijetí úplaty, pokud plnění nebylo uskutečněno dříve. Nezaplacená záloha povinnost přiznat daň nezakládá.',
       'VAT arises on the day the payment is received, unless the supply took place earlier. An unpaid advance gives rise to no VAT obligation.') }}
  {% else %}
  {{ t('Každá platba uvedená v rozpisu je samostatným zdanitelným plněním; daň se uplatní ke dni její splatnosti nebo přijetí úplaty podle toho, který nastane dříve.',
       'Each payment listed in the schedule is a separate taxable supply; VAT applies on its due date or on receipt of payment, whichever occurs first.') }}
  {% endif %}
</div>
{% endif %}

{% if invoice.note_below_items %}
<div class="note">{{ invoice.note_below_items|nl2br }}</div>
{% endif %}

{% if invoice.invoice_type == 'proforma' %}
<div class="note proforma-note">
  {{ t('Nejedná se o daňový doklad, ten bude vystaven po připsání platby.',
       'This is not a tax document. The tax document will be issued after payment is received.') }}
</div>
{% endif %}

<div class="footer">
  <span class="footer-name">{{ supplier.company_name }}</span>{% if supplier.web %}<span class="footer-dot">&#160;·&#160;</span><a href="{{ supplier.web }}" class="footer-link">{{ supplier.web|replace({'https://': '', 'http://': ''})|trim('/') }}</a>{% endif %}{% if supplier.email %}<span class="footer-dot">&#160;·&#160;</span>{{ supplier.email }}{% endif %}
</div>
{% if supplier.commercial_register %}
<div class="commercial-register">{{ supplier.commercial_register }}</div>
{% endif %}

{# ─── VÝKAZ VÍCEPRACÍ + VÝKAZ MATERIÁLU — 2. stránka ─── #}
{% set _has_work = work_report and (work_report.items|length) > 0 %}
{% set _has_material = work_report and work_report.material_total > 0 and (work_report.materials|default([])|length) > 0 %}
{% if _has_work or _has_material %}
{% set _doc_type = (_has_work and _has_material)
      ? t('Výkaz prací a materiálu', 'Work & material report')
      : (_has_work ? t('Výkaz víceprací', 'Work report') : t('Výkaz materiálu', 'Material report')) %}
<div class="page-break"></div>

<table class="head">
  <tr>
    {% if logo_show_name and logo_path and logo_path is not empty %}
      {# Logo + název firmy: dvě SOUSEDNÍ buňky .head (žádná vnořená tabulka — ta v mPDF
         mazala spodní čáru hlavičky). Mezeru dělá pevná šířka buňky loga: mPDF na buňce
         respektuje `width`, ne padding. #}
      <td class="logo-img-cell"><img src="{{ logo_path }}" alt="logo" style="max-width: 16mm; max-height: 18mm;"></td>
      <td class="logo-name">{{ supplier.display_name|default(supplier.company_name) }}</td>
    {% else %}
      <td class="logo">
        {% if logo_path and logo_path is not empty %}
          <img src="{{ logo_path }}" alt="logo" style="max-width: 72mm; max-height: 20mm;">
        {% else %}
          <div class="brand-name">{{ supplier.company_name }}</div>
        {% endif %}
      </td>
    {% endif %}
    <td class="meta">
      <div class="doc-type">{{ _doc_type }}</div>
      {% if invoice.varsymbol %}
        <div class="varsymbol-big">{{ invoice.varsymbol }}</div>
      {% endif %}
    </td>
  </tr>
</table>

<div style="margin-bottom:5mm;">
  <div class="wr-title">{{ work_report.title }}</div>
  <div style="font-size:9pt;color:#5A5470;">
    {{ t('K faktuře', 'For invoice') }} <span style="font-family:'geistmono',monospace;">{{ invoice.varsymbol }}</span>
    {% if invoice.project_name %} · {{ t('Zakázka', 'Project') }}: {{ invoice.project_name }}{% endif %}
  </div>
</div>

{% if _has_work %}
{# Cíl interního odkazu z položky práce ve faktuře (mPDF named destination). #}
<a name="work-report"></a>
{% include 'work_report_items.twig' %}
{% endif %}

{% if _has_material %}
{% set qty_dec    = (work_report.materials|filter(m => m.quantity != m.quantity|round(0))|length) > 0 ? 3 : 0 %}
{% set mprice_dec = (work_report.materials|filter(m => m.unit_price != m.unit_price|round(0))|length) > 0 ? 2 : 0 %}
{% set mtotal_dec = (work_report.materials|filter(m => m.total_amount != m.total_amount|round(0))|length) > 0 ? 2 : 0 %}
{# Cíl interního odkazu z položky materiálu ve faktuře (mPDF named destination). #}
<a name="work-report-material"></a>
<div class="wr-title" style="font-size:10pt;margin-top:{% if _has_work %}6mm{% else %}0{% endif %};margin-bottom:2mm;">{{ work_report.material_title|default(t('Materiál', 'Material')) }}</div>
<table class="items">
  <thead>
    <tr>
      <th style="width:52%">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Množství', 'Quantity') }}</th>
      <th class="nowrap" style="width:9%">{{ t('MJ', 'Unit') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Cena/MJ', 'Unit price') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Celkem', 'Total') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for m in work_report.materials %}
    <tr>
      <td>{{ m.description|nl2br }}</td>
      <td class="num nowrap">{{ m.quantity|number_format(qty_dec, decimal_sep, thousand_sep) }}</td>
      <td class="nowrap">{{ m.unit }}</td>
      <td class="num nowrap">{{ m.unit_price|number_format(mprice_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
      <td class="num nowrap">{{ m.total_amount|number_format(mtotal_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% endfor %}
    <tr class="wr-total">
      <td style="text-align:right;" colspan="4">{% if supplier.is_vat_payer %}{{ t('Celkem bez DPH', 'Total excl. VAT') }}{% else %}{{ t('Celkem', 'Total') }}{% endif %}</td>
      <td class="num nowrap">{{ work_report.material_total|number_format(supplier.is_vat_payer ? 2 : mtotal_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% if supplier.is_vat_payer %}
    <tr class="wr-total">
      <td style="text-align:right;" colspan="4">{{ t('Celkem s DPH', 'Total incl. VAT') }}{% if work_report.material_vat_rate is not null %} ({{ work_report.material_vat_rate|number_format(work_report.material_vat_rate == work_report.material_vat_rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%){% endif %}</td>
      <td class="num nowrap">{{ work_report.material_total_with_vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}

<div class="footer">
  <span class="footer-name">{{ supplier.company_name }}</span>{% if supplier.web %}<span class="footer-dot">&#160;·&#160;</span><a href="{{ supplier.web }}" class="footer-link">{{ supplier.web|replace({'https://': '', 'http://': ''})|trim('/') }}</a>{% endif %}{% if supplier.email %}<span class="footer-dot">&#160;·&#160;</span>{{ supplier.email }}{% endif %}
</div>
{% if supplier.commercial_register %}
<div class="commercial-register">{{ supplier.commercial_register }}</div>
{% endif %}
{% endif %}

</body>
</html>
