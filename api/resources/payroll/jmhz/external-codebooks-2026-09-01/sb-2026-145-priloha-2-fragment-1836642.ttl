                "<table data-opakovatzahlavi=\"NaKazdeStrance\" data-zoom-tabulky=\"50\" class=\"TABLE1\" data-tisk-na-sirku=\"true\"><thead><tr data-row-key=\"19b0dd3d-4e04-451f-9f18-029a83b66390\"><th style=\"text-align: center; width:10.4598%;\">Název kraje</th><th style=\"text-align: center; width:10.1681%;\">Název okresu</th><th style=\"text-align: center; width:10.3018%;\">Název obce</th><th style=\"text-align: center; width:5.3977%;\">Kód obce</th><th style=\"text-align: center; width:5.9617%;\">Počet obyvatel<br>k 1. lednu 2026</th><th style=\"text-align: center; width:9.8976%;\">Započtená výměra katastrálních území obce<br>k 1. lednu 2026 v hektarech</th><th style=\"text-align: center; width:8.6606%;\">Přepočtený počet dětí, žáků a studentů ve školách nebo školských zařízeních zřizovaných obcí nebo dobrovolným svazkem obcí</th><th style=\"text-align: center; width:7.1987%;\">Koeficienty<br>postupných přechodů (<a data-odkaz-id=\"891554\" href=\"#\" class=\"ext_odkaz\">příloha č. 2 k zákonu o rozpočtovém určení daní</a>)</th><th style=\"text-align: center; width:12.8231%;\">Procentní podíl obce na částech celostátního hrubého výnosu daní podle <a data-odkaz-id=\"891550\" href=\"#\" class=\"ext_odkaz\">§ 4 odst. 1 písm. b) až f)</a> a výnosu záloh a daně podle <a data-odkaz-id=\"891552\" href=\"#\" class=\"ext_odkaz\">§ 4 odst. 1 písm. i) zákona o rozpočtovém určení daní</a><br>(k <a data-odkaz-id=\"891540\" href=\"#\" class=\"int_odkaz\">§ 3</a>)</th><th style=\"text-align: center; width:10.01%;\">Počet zaměstnanců<br>k 1. prosinci 2025</th><th style=\"text-align: center; width:9.1209%;\">Procentní podíl obce na části celostátního hrubého výnosu daně podle <a data-odkaz-id=\"891548\" href=\"#\" class=\"ext_odkaz\">§ 4 odst. 1 písm. h) zákona o rozpočtovém určení daní</a><br>(k <a data-odkaz-id=\"891542\" href=\"#\" class=\"int_odkaz\">§ 4</a>)</th></tr><tr data-row-key=\"dada6531-a048-47ce-a5de-03a3e2ae4551\"><th style=\"text-align: center;\">1</th><th style=\"text-align: center;\">2</th><th style=\"text-align: center;\">3</th><th style=\"text-align: center;\">4</th><th style=\"text-align: center;\">5</th><th style=\"text-align: center;\">6</th><th style=\"text-align: center;\">7</th><th style=\"text-align: center;\">8</th><th style=\"text-align: center;\">9</th><th style=\"text-align: center;\">10</th><th style=\"text-align: center;\">11</th></tr></thead><tbody><tr data-row-key=\"cbe654b8-a65d-48b8-8481-b843d2774eeb\"><td>Hlavní město Praha</td><td>Hlavní město Praha</td><td>Hlavní město Praha</td><td style=\"text-align: center;\">554 782</td><td style=\"text-align: right;\">1 407 084</td><td style=\"text-align: right;\">49 620,8310</td><td style=\"text-align: right;\">153 299,1</td><td style=\"text-align: right;\"></td><td style=\"text-align: right;\">28,289191</td><td style=\"text-align: right;\">1 186 569</td><td style=\"text-align: right;\">21,186167</td></tr><tr data-row-key=\"21abfe13-2d66-49f9-9125-a59ac2b61c19\"><td>Středočeský kraj</td><td>Benešov</td><td>Benešov</td><td style=\"text-align: center;\">529 303</td><td style=\"text-align: right;\">17 025</td><td style=\"text-align: right;\">4 687,0084</td><td style=\"text-align: right;\">3 282,1</td><td style=\"text-align: right;\">1,1523</td><td style=\"text-align: right;\">0,128126</td><td style=\"text-align: right;\">13 207</td><td style=\"text-align: right;\">0,235811</td></tr><tr data-row-key=\"12095b2f-6c6d-49fe-8912-9e3e7c247cf9\"><td>Středočeský kraj</td><td>Benešov</td><td>Bernartice</td><td style=\"text-align: center;\">532 568</td><td style=\"text-align: right;\">222</td><td style=\"text-align: right;\">1 010,9743</td><td style=\"text-align: right;\">0,0</td><td style=\"text-align: right;\">1,0700</td><td style=\"text-align: right;\">0,001481</td><td style=\"text-align: right;\">100</td><td style=\"text-align: right;\">0,001785</td></tr><tr data-row-key=\"4ee197b2-711b-441f-88e3-d7154a5936f1\"><td>Středočeský kraj</td><td>Benešov</td><td>Bílkovice</td