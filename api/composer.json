{
    "name": "myucto/api",
    "description": "MyUcto.cz — fakturační systém (PHP backend)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-simplexml": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "chillerlan/php-qrcode": "^6.0",
        "dragonofmercy/phppdf": "^1.0",
        "enshrined/svg-sanitize": "^0.22",
        "guzzlehttp/guzzle": "^7.11",
        "monolog/monolog": "^3.7",
        "mpdf/mpdf": "^8.2",
        "paragonie/sodium_compat": "^2.1",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^5.8",
        "predis/predis": "^3.5",
        "respect/validation": "^3.1",
        "rikudou/czqrpayment": "^5.3",
        "rikudou/iban": "^1.3",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.13",
        "smalot/pdfparser": "^2.12",
        "smhg/sepa-qr-data": "^3.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/uid": "^8.0",
        "twig/twig": "^3.10",
        "web-auth/webauthn-lib": "^5.3",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "brianium/paratest": "^7.23",
        "dg/bypass-finals": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2.5"
    },
    "suggest": {
        "ext-sodium": "Nativní Ed25519 pro ověření licenčního tokenu. Bez něj se použije čistě PHP fallback paragonie/sodium_compat (pomalejší, funkčně shodný).",
        "ext-curl": "Stahování aktualizací a odchozí HTTP. Bez něj se použije fallback přes allow_url_fopen.",
        "ext-soap": "Ověření DIČ v EU přes VIES SOAP. Bez něj zůstává primární REST cesta.",
        "ext-redis": "Není potřeba — Redis se používá přes čistě PHP klienta predis/predis.",
        "ext-imagick": "Kvalitnější náhledy dokumentů a převod SVG log; bez něj se použije ext-gd, případně rsvg-convert.",
        "ext-intl": "Lokalizované formátování; aplikace má vlastní české formátování jako výchozí.",
        "ext-exif": "Orientace fotek u nahraných příloh.",
        "ext-opcache": "Silně doporučeno v produkci — bez něj běží aplikace řádově pomaleji."
    },
    "autoload": {
        "psr-4": {
            "MyInvoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyInvoice\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/cleanup-mpdf-fonts.php",
            "@php bin/patch-mpdf-ttfontfile.php"
        ],
        "post-update-cmd": [
            "@php bin/cleanup-mpdf-fonts.php",
            "@php bin/patch-mpdf-ttfontfile.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
