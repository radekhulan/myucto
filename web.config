<?xml version="1.0" encoding="UTF-8"?>
<!--
  MyUcto.cz — IIS configuration

  - /api/* requesty jdou na api/public/index.php (Slim FrontController)
  - statika ze /styles/, /assets/ a PWA soubory jde napřímo
  - vše ostatní → api/public/index.php (host gate + Vue SPA fallback)
  - blokované složky: /api/src/, /api/vendor/, /db/, /private/, /storage/, /log/, /source/, /web/shared/

  PHP 8.5 musí být registrováno v IIS jako handler pro *.php (nepřidáváme zde,
  patří to do globální IIS konfigurace).
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security"  value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options"     value="nosniff" />
        <add name="X-Frame-Options"            value="SAMEORIGIN" />
        <add name="Referrer-Policy"            value="same-origin" />
        <!-- Permissions-Policy: blokujeme jen camera/mic/geolocation/payment (rare
             pro fakturaci), explicitně POVOLUJEME accelerometer/gyroscope/magnetometer/
             xr-spatial-tracking pro Cloudflare Turnstile iframe (human-detection
             fingerprinting). Bez toho `[Violation] xr-spatial-tracking is not allowed`
             v console + může způsobit, že Turnstile nedokáže vystavit token. -->
        <add name="Permissions-Policy"         value="camera=(), microphone=(), geolocation=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self), accelerometer=(self &quot;https://challenges.cloudflare.com&quot;), gyroscope=(self &quot;https://challenges.cloudflare.com&quot;), magnetometer=(self &quot;https://challenges.cloudflare.com&quot;), xr-spatial-tracking=(self &quot;https://challenges.cloudflare.com&quot;)" />
        <add name="Cross-Origin-Opener-Policy"   value="same-origin" />
        <!-- CORP `same-site` (ne `same-origin`) — striktní `same-origin` blokoval
             same-origin GET na /styles/logo.svg z /manual stránky otevřené přes
             target="_blank" (Chrome `ERR_BLOCKED_BY_RESPONSE.NotSameOrigin`).
             `same-site` zachovává ochranu proti cross-domain leakům. -->
        <add name="Cross-Origin-Resource-Policy" value="same-site" />
        <!-- Cross-Origin-Embedder-Policy záměrně vynecháno — `require-corp` by rozbil Turnstile iframe (Cloudflare nevrací CORP header). -->
        <!-- 'unsafe-inline' v script-src — Cloudflare Turnstile potřebuje
             inline JS pro Widget bootstrap (dokumentace doporučuje, alternativa
             je nonce-per-request). Bez něj `400 captcha_failed` na login/forgot. -->
        <!-- script-src: 'self' + Turnstile + Swagger UI CDN (unpkg.com) pro /api/docs
                       + cdn.jsdelivr.net (Scalar) pro /api/scalar
             style-src: unpkg.com pro Swagger UI CSS + cdn.jsdelivr.net pro Scalar
             worker-src: blob: — Swagger UI / Redoc / Turnstile používají blob workery
             font-src: data: — Swagger UI / Redoc embedují fonty jako data URIs
             img-src: data: + validator.swagger.io pro validní spec badge -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; img-src 'self' data: blob: https://validator.swagger.io https://cdn.redoc.ly https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://unpkg.com https://cdn.redoc.ly https://cdn.jsdelivr.net; worker-src 'self' blob:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://unpkg.com https://cdn.redoc.ly https://cdn.jsdelivr.net; frame-src 'self' blob: https://challenges.cloudflare.com chrome-extension: moz-extension:; object-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
      <redirectHeaders>
        <clear />
      </redirectHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <!--
          IIS hiddenSegments NESMÍ obsahovat '/' nebo '\' — jen jedno-segmentová jména.
          Pro composite cesty (api/src, api/vendor) máme rewrite rule "Block sensitive directories" níže.
          Tyto segmenty se blokují globálně (kdekoli v URL):
        -->
        <hiddenSegments>
          <add segment="vendor" />
          <!-- hiddenSegments matchuje CELÉ segmenty, takže 'vendor' nepokryje
               'vendor.prod' — produkční autoloader v api/vendor.prod/ musí být
               vyjmenovaný zvlášť (defense-in-depth k rewrite pravidlu níže). -->
          <add segment="vendor.prod" />
          <add segment="node_modules" />
          <add segment="db" />
          <add segment="private" />
          <add segment="storage" />
          <add segment="log" />
          <add segment="tools" />
          <add segment=".git" />
          <add segment=".vscode" />
          <add segment=".claude" />
        </hiddenSegments>
        <!--
          "source" byl v hiddenSegments odstraněn — hiddenSegments blokuje daný
          segment KDEKOLI v URL (ne jen na začátku), takže kolidoval s legitimní
          API route /api/purchase-invoices/{id}/source (404.8, PHP se vůbec
          nespustilo). Root-level /source/ (plánovací dokumenty) je už pokryté
          anchored rewrite pravidlem "Block sensitive directories" níže.
        -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".pem" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <!-- Pomocné skripty leží s docrootem v kořeni bundlu ve veřejném
               prostoru a prozrazují cesty i postup nasazení. -->
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- OpenAPI spec — servíruje se přímo z api/openapi.yaml jako statický soubor.
           IIS by jinak vrátil 404.3 (neznámý MIME). Při změně specu netřeba PHP. -->
      <remove fileExtension=".yaml" />
      <mimeMap fileExtension=".yaml" mimeType="application/yaml" />
      <!-- Self-hostované webfonty. Starší IIS .woff2 nezná a vrátil by 404.3;
           `remove` napřed drží pravidlo idempotentní i tam, kde už mapování je. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Default cache 1 rok pro statiku s hashem (assets, fonty) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- index.html (a /api/*) MUSÍ být no-cache, aby browser dostal aktuální verzi
         hashed assets. Pro index.html přepisujeme níže rewriteu.
         IIS nemůže elegantně override clientCache per URL — řešení přes outboundRule. -->
    <rewrite>
      <outboundRules>
        <!-- /api/* a hostované MCP/OAuth → Cache-Control: no-store bez ohledu na to,
             co poslala aplikace (stažené faktury, výkazy a exporty nesmí zůstat
             v cache sdíleného prohlížeče). Parita s .htaccess (env NOCACHE) a nginx
             ($mi_cache_control). -->
        <rule name="API no-store" preCondition="IsApi">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-store" />
        </rule>
        <!-- index.html → Cache-Control: no-cache (vždy fresh manifest) -->
        <rule name="HTML no-cache" preCondition="IsHTML">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <rule name="PWA control files no-cache" preCondition="IsPwaControlFile">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <preConditions>
          <preCondition name="IsApi">
            <add input="{REQUEST_URI}" pattern="^/(api/|mcp/?(\?|$)|oauth/|\.well-known/oauth-)" />
          </preCondition>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_Content_Type}" pattern="^text/html" />
          </preCondition>
          <preCondition name="IsPwaControlFile">
            <add input="{REQUEST_URI}" pattern="^/(service-worker\.js|manifest\.webmanifest)$" />
          </preCondition>
        </preConditions>
      </outboundRules>
      <rules>
        <!-- 0) HTTP → HTTPS 301 redirect — vyjma:
             - loopback / localhost (lokální dev a Docker port-forward)
             - RFC1918 privátní IP (LAN nasazení bez TLS — typicky self-hosted Docker)
             - .local mDNS jména
             - requests už HTTPS, nebo terminované TLS na reverse proxy (X-Forwarded-Proto) -->
        <rule name="HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" ignoreCase="true" negate="true" />
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" ignoreCase="true" negate="true" />
            <add input="{HTTP_HOST}" pattern="^127\." negate="true" />
            <add input="{HTTP_HOST}" pattern="^10\." negate="true" />
            <add input="{HTTP_HOST}" pattern="^192\.168\." negate="true" />
            <add input="{HTTP_HOST}" pattern="^172\.(1[6-9]|2[0-9]|3[0-1])\." negate="true" />
            <add input="{HTTP_HOST}" pattern="\.local(:\d+)?$" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 1) /api/* → api/public/index.php -->
        <rule name="API" stopProcessing="true">
          <match url="^api/(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>

        <!-- 2) Bezpečnostní bariéra: blokovat citlivé a vývojové složky.
             `web/shared/` obsahuje zdrojové policy pro PHP a frontend build, ne veřejná data.
             `(?:\.[^/]*)?` za jménem složky je ZÁMĚRNÉ: na disku reálně existuje
             `api/vendor.prod/` (produkční autoloader) a holé `vendor` ho nematchne
             (následuje '.', ne '/'). hiddenSegments taky nepomůže — matchuje celé
             segmenty a 'vendor.prod' != 'vendor'. Pokrývá i `private.bak/` apod.;
             suffix se kotví na tečku, takže legitimní /dbxyz zůstává dostupné. -->
        <rule name="Block sensitive directories" stopProcessing="true">
          <match url="^(private|db|log|source|storage|tools|cmd|docker|web/(src|shared|node_modules)|node_modules|api/(src|vendor|templates|tests|bin))(?:\.[^/]*)?(/.*)?$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 2b) Blokuj cfg.php, tooling manifesty a zdrojové soubory
             (i .md zdrojové manuálu — uživatel ho dostane jen v HTML rendru přes /manual).
             `(?:(?:api|web)/)?` — `api/composer.json` a `api/composer.lock` jsou
             reálné soubory a root-kotvený regex je minul. -->
        <rule name="Block sensitive files" stopProcessing="true">
          <match url="^(?:(?:api|web)/)?(cfg\.sample\.php|cfg\.docker\.php|VERSION|web\.config|portainer-template\.json|cfg\.php|cfg\.local\.php|composer\.(json|lock)|package\.json|pnpm-lock\.yaml|(?:vite|tsconfig|eslint|tailwind|postcss)\.config\.[^/]+|phpunit\.xml(?:\.dist)?|Dockerfile(?:\..*)?|docker-compose[^/]*|\.gitignore|\.env.*|.*\.md|.*\.sql)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 2d) Zámek údržby (H-03) — VRSTVA NAVÍC, ne bezpečnostní hranice.
             Zrcadlí pravidlo 2d v .htaccess; drž obojí v synchronizaci.

             Hlavní kontrola je v PHP (MaintenanceModeMiddleware + inline brána
             ve front controlleru). Ta ale nikdy neuvidí požadavky, které IIS
             odbaví sám ze statiky (/assets/, /fonts/, /styles/, PWA soubory) —
             tohle pravidlo je v údržbě pošle na front controller. Odpověď
             (503, Retry-After, HTML pro prohlížeč vs. JSON podle `Accept`)
             tedy pořád tvoří PHP na jednom místě; `CustomResponse` by tady
             Retry-After ani obsahovou negociaci vrátit neuměl.

             Zámek leží MIMO docroot, proto se na něj míří relativně od něj.
             IIS neumí v jednom pravidle míchat MatchAll a MatchAny, takže obě
             rozložení (data dir nad docrootem = spravovaná instalace, data dir
             v docrootu = self-hosted default) mají vlastní pravidlo.

             /api/* už řeší pravidlo 1 (jde na front controller vždy), takže se
             tady řeší jen zbytek. /api/health je i tak vyjmuté explicitně —
             hosting jinak nepozná rozdíl mezi údržbou a výpadkem. -->
        <rule name="Maintenance lock (data dir above docroot)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api/(v1/)?health/?$" negate="true" />
            <add input="{DOCUMENT_ROOT}/../storage/maintenance.lock" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>
        <rule name="Maintenance lock (data dir in docroot)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api/(v1/)?health/?$" negate="true" />
            <add input="{DOCUMENT_ROOT}/storage/maintenance.lock" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>

        <!-- Přímý index ani adresářový default nesmí obejít tenant host gate. -->
        <rule name="Direct SPA index host gate" stopProcessing="true">
          <match url="^web/dist(?:/index\.html)?/?$" />
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>

        <!-- 3) /styles/* fall-through (statika v rootu existuje) -->

        <!-- 3b) /assets/* → web/dist/assets/* (statické bundly Vite) -->
        <rule name="Vite assets" stopProcessing="true">
          <match url="^assets/(.*)$" />
          <action type="Rewrite" url="web/dist/assets/{R:1}" />
        </rule>

        <!-- 3b-2) /fonts/* → web/dist/fonts/* (self-hostované woff2 z web/public/fonts).
             Bez tohoto pravidla by je spolkl SPA fallback a vrátil index.html
             s Content-Type text/html — prohlížeč font tiše zahodí a spadne na
             systémový fallback (přesně to se dělo, než se fonty vůbec hostovaly). -->
        <rule name="Self-hosted fonts" stopProcessing="true">
          <match url="^fonts/(.*)$" />
          <action type="Rewrite" url="web/dist/fonts/{R:1}" />
        </rule>

        <!-- 3c) PWA soubory generované Vitem; service worker je v rootu kvůli scope `/`. -->
        <rule name="PWA service worker" stopProcessing="true">
          <match url="^service-worker\.js$" />
          <action type="Rewrite" url="web/dist/service-worker.js" />
        </rule>
        <rule name="PWA manifest" stopProcessing="true">
          <match url="^manifest\.webmanifest$" />
          <action type="Rewrite" url="web/dist/manifest.webmanifest" />
        </rule>
        <rule name="PWA icons" stopProcessing="true">
          <match url="^pwa/(.*)$" />
          <action type="Rewrite" url="web/dist/pwa/{R:1}" />
        </rule>

        <!-- 3d) /manual a /manual?ch=... → manual/index.php (HTML manuál).
             Statické soubory v /manual/img/ a /manual/generated/ se servírují přímo
             (real file existuje), tady jen "pretty" /manual URL. -->
        <rule name="Manual route" stopProcessing="true">
          <match url="^manual/?$" />
          <action type="Rewrite" url="manual/index.php" appendQueryString="true" />
        </rule>

        <!-- 3c) Některé soubory v rootu projektu, které frontend referencuje (favicon atd.) — fall-through -->

        <!-- 4a) Root URL "/" → front controller; ten ověří hostname a vydá SPA. -->
        <rule name="Root SPA index" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>
        <rule name="Block MCP source" stopProcessing="true">
          <match url="^mcp/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <rule name="Hosted MCP and OAuth" stopProcessing="true">
          <match url="^(mcp|oauth/(authorize|token|register)|\.well-known/oauth-(protected-resource(/mcp)?|authorization-server))/?$" />
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>

        <!-- 4b) SPA fallback — front controller odmítne neznámý/neaktivní Host
             a teprve pro povolený tenant vydá web/dist/index.html. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"      pattern="^/api/"        negate="true" />
          </conditions>
          <action type="Rewrite" url="api/public/index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
